# 站点根地址（canonical、RSS、OG、sitemap 链接的基准；本地开发可留默认值）
SITE_URL=http://localhost:4321

# Payload 后台 API 地址（只要域名，不带 /api）。
# 留空时会依次回退：SITE_URL → http://localhost:9527（本地后台）。
PUBLIC_PAYLOAD_URL=http://localhost:9527

# Twikoo 评论服务环境 ID（留空 = 关闭评论）
PUBLIC_TWIKOO_ENV_ID=

# 网易云音乐歌单（前台音乐播放器）
PUBLIC_NETEASE_PLAYLIST_ID=8792942606
PUBLIC_MUSIC_API=https://meting.mikus.ink/api
