---
import {
  BRAND_ICONS,
  brandRenderSize,
  brandTransform,
  iconInnerMarkup,
  isBrandIcon,
} from 'cloud-blog/shared/icon-paths';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className, strokeWidth = 1.75 } = Astro.props;

// 图标表在 shared/icon-paths.ts：Astro 构建层与 CMS 注入层共用同一份，
// 否则后台同步一次就可能把构建时画得好好的图标换成空白。
const isBrand = isBrandIcon(name);
const inner = iconInnerMarkup(name);
const brand = isBrand ? BRAND_ICONS[name] : undefined;
// 品牌图形铺满 viewBox，线性图标自带内边距，同尺寸下前者显大 —— 收一档才视觉等大。
const renderSize = isBrand ? brandRenderSize(size) : size;
const transform = isBrand ? brandTransform(name) : undefined;
// 官方色写进内联自定义属性，由 global.css 的 .brand-glyph 决定实际 fill：
// 深色主题下允许换成读得清的官方变体（X 的官方规范就是纯黑或纯白两种）。
const brandStyle = brand?.color
  ? `--glyph-color:${brand.color};--glyph-color-dark:${brand.darkColor ?? brand.color};`
  : undefined;
---

{isBrand ? (
  <svg
    class={className}
    class:list={['brand-glyph']}
    style={brandStyle}
    width={renderSize}
    height={renderSize}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  ><g transform={transform} set:html={inner}></g></svg>
) : (
  <svg
    class={className}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={inner}
  ></svg>
)
}
