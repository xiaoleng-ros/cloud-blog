---
import Icon from './Icon.astro';
import { site, toShanghaiParts } from '../lib/posts';
import { getFooter, getSiteSettings } from '../lib/site-settings';

// 构建年份仅作为无 JS 环境的静态兜底；按全仓统一的 Asia/Shanghai 定格（与 formatDate 同口径）
const buildYear = toShanghaiParts(new Date())?.year ?? String(new Date().getFullYear());

// 作者名：优先后台站点设置，后台不可用时回退本地配置
const settings = await getSiteSettings();
const author = settings?.siteAuthor ?? site.author;

// 页脚副标题/链接/群组：优先后台站点设置（可随时在后台修改），缺失时回退默认值
const footer = await getFooter();
const channels = footer.channels;
const groups = footer.groups;
---

<footer class="site-footer">
  <div class="site-footer__inner" data-sync-block="footerInner">
    <div class="site-footer__id">
      <img
        src="/avatars/avatar.png"
        alt={author}
        class="site-footer__avatar"
        width="40"
        height="40"
      />
      <div class="site-footer__id-text">
        <strong>{author}</strong>
        <span>{footer.subtitle}</span>
      </div>
    </div>

    <nav class="site-footer__links" aria-label="页脚链接">
      {channels.map(({ name, icon, href }) => (
        <a
          href={href}
          target={href.startsWith('http') ? '_blank' : undefined}
          rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <Icon name={icon} size={15} />
          {name}
        </a>
      ))}
      {groups.length > 0 && (
        <>
          <span class="site-footer__sep" aria-hidden="true"></span>
          {groups.map(({ name, icon, href }) => (
            href ? (
              <a
                href={href}
                target={href.startsWith('http') ? '_blank' : undefined}
                rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <Icon name={icon} size={15} />
                {name}
              </a>
            ) : (
              <span class="site-footer__item">
                <Icon name={icon} size={15} />
                {name}
              </span>
            )
          ))}
        </>
      )}
    </nav>
  </div>

  <div class="site-footer__bar" data-sync-block="footerBar">
    <span>© <span data-copyright-year>{buildYear}</span> {author}</span>
    <span aria-hidden="true">·</span>
    <a href={site.url}>{site.url.replace('https://', '')}</a>
    <span aria-hidden="true">·</span>
    <span>由 <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> 构建</span>
  </div>
</footer>

<script is:inline data-astro-rerun>
  (() => {
    // 静态产物里的年份是构建时冻结的：这里刷新为当前年份，无副作用。
    // 年份口径与全站一致按 Asia/Shanghai 定格（访客本地年在跨年窗口会与归档/文章页对不上）。
    // footerBar 会被后台数据同步整块替换，故同时监听 blog:sync-updated 重打补丁。
    const setYear = () => {
      const y = new Intl.DateTimeFormat('en', { timeZone: 'Asia/Shanghai', year: 'numeric' }).format(new Date());
      document.querySelectorAll('[data-copyright-year]').forEach((el) => {
        el.textContent = y;
      });
    };
    setYear();
    window.__blogFooterYearCleanup?.();
    const onSync = () => setYear();
    document.addEventListener('blog:sync-updated', onSync);
    window.__blogFooterYearCleanup = () => document.removeEventListener('blog:sync-updated', onSync);
  })();
</script>
