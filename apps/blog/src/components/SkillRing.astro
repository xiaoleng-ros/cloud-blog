---
import { resolveAboutColor } from 'cloud-blog/shared/about-format';

export interface Props {
  label: string;
  sublabel?: string;
  value: number;
  /** 预设 token（yellow/cyan/pink/green/purple）或任意 hex；空回退淡黄 */
  color?: string;
}

const { label, sublabel, value, color } = Astro.props;

const ringColor = resolveAboutColor(color) || 'var(--sticky-yellow)';
const percent = Math.min(100, Math.max(0, value));
---

<div class="skill-ring">
  <div class="skill-ring__track" aria-hidden="true">
    <div
      class="skill-ring__fill"
      style={`--ring-color: ${ringColor}; --percent: ${percent}%`}
    ></div>
    <span class="skill-ring__value">{percent}%</span>
  </div>
  <div class="skill-ring__text">
    <strong>{label}</strong>
    {sublabel && <small>{sublabel}</small>}
  </div>
</div>
