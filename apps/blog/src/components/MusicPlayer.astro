---
import arrowSquareOutIcon from '@phosphor-icons/core/assets/regular/arrow-square-out.svg?raw';
import heartIcon from '@phosphor-icons/core/assets/regular/heart.svg?raw';
import heartFillIcon from '@phosphor-icons/core/assets/fill/heart-fill.svg?raw';
import musicNotesIcon from '@phosphor-icons/core/assets/regular/music-notes.svg?raw';
import pauseIcon from '@phosphor-icons/core/assets/fill/pause-fill.svg?raw';
import playIcon from '@phosphor-icons/core/assets/fill/play-fill.svg?raw';
import repeatIcon from '@phosphor-icons/core/assets/regular/repeat.svg?raw';
import shuffleIcon from '@phosphor-icons/core/assets/regular/shuffle.svg?raw';
import skipBackIcon from '@phosphor-icons/core/assets/fill/skip-back-fill.svg?raw';
import skipForwardIcon from '@phosphor-icons/core/assets/fill/skip-forward-fill.svg?raw';
import speakerHighIcon from '@phosphor-icons/core/assets/regular/speaker-high.svg?raw';
import speakerSlashIcon from '@phosphor-icons/core/assets/regular/speaker-slash.svg?raw';
import waveformIcon from '@phosphor-icons/core/assets/regular/waveform.svg?raw';
import xIcon from '@phosphor-icons/core/assets/regular/x.svg?raw';

// 歌单 ID：后台站点设置（SiteSettings.neteasePlaylistId）优先 → 环境变量兜底。
// 播放器现在「常驻渲染」，配置变化由运行时同步（BaseLayout applyRuntime）接住：
//   - data-playlist-id       当前值（构建期是快照，运行时会被同步脚本改成最新）
//   - data-playlist-fallback 构建期 env 兜底值（后台字段留空时生效）
// 后台字段与 env 都拿不到合法纯数字 ID 时整块隐藏（hidden），避免导向不存在的歌单。
import { getSiteSettings } from '../lib/site-settings';

const settings = await getSiteSettings();
// 合法 ID = 纯数字：历史上这个字段被填过 "NaN"，会把播放器导向一个不存在的歌单，比没有更糟。
const validId = (value: string | undefined) => {
  const raw = String(value ?? '').trim();
  return /^\d+$/.test(raw) ? raw : '';
};
const envPlaylistId = validId(import.meta.env.PUBLIC_NETEASE_PLAYLIST_ID);
const settingsRaw = String(settings?.neteasePlaylistId ?? '').trim();
// 与 blog-render 的 runtime.playlist 口径一致：后台填了合法值用它；填了非法值=停用（不回退 env）；留空=env 兜底
const playlistId = validId(settingsRaw) || (settingsRaw ? '' : envPlaylistId);

const apiBase =
  String(import.meta.env.PUBLIC_MUSIC_API ?? 'https://meting.mikus.ink/api').trim() ||
  'https://meting.mikus.ink/api';
const playlistHref = `https://music.163.com/#/playlist?id=${encodeURIComponent(playlistId)}`;
---

{/* 常驻渲染（不再构建期条件渲染）：后台/运行时的歌单变化都要能被同步接住。
     无歌单时用 hidden 隐藏（见样式里的 [hidden] 强制），运行时同步会按最新值切换。 */}
<div
  class="music-player"
  transition:name="music-player"
  transition:persist="music-player"
  transition:animate="none"
  data-music-player
  data-testid="music-player"
  data-playlist-id={playlistId}
  data-playlist-fallback={envPlaylistId}
  data-api-base={apiBase}
  hidden={!playlistId}
>
  <section
    id="music-player-panel"
    class="music-player__panel"
    data-music-panel
    data-testid="music-panel"
    aria-label="音乐播放器"
    aria-hidden="true"
    inert
  >
    <header class="music-player__header">
      <div class="music-player__playing-state">
        <span class="music-player__icon music-player__status-icon" aria-hidden="true" set:html={waveformIcon}></span>
        <span class="music-player__status" data-music-status aria-live="polite">正在连接歌单…</span>
      </div>
      <div class="music-player__header-actions">
        <button type="button" data-music-mute aria-label="静音" title="静音" disabled>
          <span class="music-player__icon music-player__volume-icon" aria-hidden="true" set:html={speakerHighIcon}></span>
          <span class="music-player__icon music-player__muted-icon" aria-hidden="true" set:html={speakerSlashIcon}></span>
        </button>
        <a
          href={playlistHref}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="在网易云音乐中打开歌单"
          title="在网易云音乐中打开"
        >
          <span class="music-player__icon" aria-hidden="true" set:html={arrowSquareOutIcon}></span>
        </a>
        <button type="button" data-music-close aria-label="收起音乐播放器" title="收起">
          <span class="music-player__icon" aria-hidden="true" set:html={xIcon}></span>
        </button>
      </div>
    </header>

    <div class="music-player__now">
      <div class="music-player__cover" aria-hidden="true">
        <span class="music-player__cover-fallback music-player__icon" set:html={musicNotesIcon}></span>
        <img data-music-cover alt="" width="132" height="132" hidden />
      </div>
      <div class="music-player__meta">
        <strong data-music-title>歌单加载中</strong>
        <span data-music-artist>网易云音乐</span>
      </div>
      <button
        type="button"
        class="music-player__favorite"
        data-music-favorite
        aria-label="收藏当前歌曲"
        aria-pressed="false"
        title="收藏"
        disabled
      >
        <span class="music-player__icon music-player__heart-icon" aria-hidden="true" set:html={heartIcon}></span>
        <span class="music-player__icon music-player__heart-fill-icon" aria-hidden="true" set:html={heartFillIcon}></span>
      </button>
    </div>

    <div class="music-player__timeline">
      <p class="music-player__lyric" data-music-lyric aria-live="off">
        <span class="music-player__lyric-line" data-music-lyric-line>♪</span>
      </p>
      <div class="music-player__seek">
        <span class="music-player__seek-track" aria-hidden="true">
          <span class="music-player__seek-fill"></span>
        </span>
        <input
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          data-music-progress
          aria-label="播放进度"
          aria-valuetext="0:00 / 0:00"
          disabled
        />
      </div>
      <div class="music-player__time" aria-hidden="true">
        <span data-music-current-time>0:00</span>
        <span data-music-duration>0:00</span>
      </div>
    </div>

    <div class="music-player__controls" aria-label="播放控制">
      <button type="button" data-music-shuffle aria-label="随机播放" aria-pressed="false" title="随机播放" disabled>
        <span class="music-player__icon" aria-hidden="true" set:html={shuffleIcon}></span>
      </button>
      <button type="button" data-music-prev aria-label="上一首" title="上一首" disabled>
        <span class="music-player__icon" aria-hidden="true" set:html={skipBackIcon}></span>
      </button>
      <button
        type="button"
        class="music-player__play"
        data-music-play
        data-testid="music-play"
        aria-label="播放"
        title="播放"
        disabled
      >
        <span class="music-player__icon music-player__play-icon" aria-hidden="true" set:html={playIcon}></span>
        <span class="music-player__icon music-player__pause-icon" aria-hidden="true" set:html={pauseIcon}></span>
      </button>
      <button type="button" data-music-next aria-label="下一首" title="下一首" disabled>
        <span class="music-player__icon" aria-hidden="true" set:html={skipForwardIcon}></span>
      </button>
      <button type="button" data-music-repeat aria-label="单曲循环" aria-pressed="false" title="单曲循环" disabled>
        <span class="music-player__icon" aria-hidden="true" set:html={repeatIcon}></span>
      </button>
    </div>

    <div class="music-player__queue-head">
      <span>播放列表</span>
      <button type="button" data-music-retry hidden>重新加载</button>
      <small data-music-count>加载中</small>
    </div>
    <ol class="music-player__queue" data-music-list aria-label="歌单曲目">
      <li class="music-player__empty" data-music-empty>正在从网易云读取歌单…</li>
    </ol>

  </section>

  <button
    type="button"
    class="music-player__toggle"
    data-music-toggle
    data-testid="music-toggle"
    aria-controls="music-player-panel"
    aria-expanded="false"
    aria-label="打开音乐播放器"
    title="音乐"
  >
    <span class="music-player__disc" aria-hidden="true">
      <span class="music-player__disc-fallback music-player__icon" set:html={musicNotesIcon}></span>
      <img data-music-dock-cover alt="" width="34" height="34" hidden />
    </span>
    <span class="music-player__pulse music-player__icon" aria-hidden="true" set:html={waveformIcon}></span>
  </button>

  <audio data-music-audio preload="none"></audio>
</div>

<style is:global>
  /* 播放器常驻渲染后用 hidden 控制显隐：组件样式会给 .music-player 设 display，需强制覆盖 */
  .music-player[hidden] {
    display: none !important;
  }

  .music-player {
    position: fixed;
    right: var(--floating-edge, clamp(1rem, 4vw, 2rem));
    bottom: calc(var(--floating-edge, clamp(1rem, 4vw, 2rem)) + env(safe-area-inset-bottom, 0px));
    z-index: 40;
    width: 3rem;
    height: 3rem;
    pointer-events: none;
  }

  .music-player button,
  .music-player input {
    font: inherit;
  }

  .music-player [hidden] {
    display: none !important;
  }

  .music-player button,
  .music-player a {
    -webkit-tap-highlight-color: transparent;
  }

  .music-player svg {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .music-player__toggle {
    position: relative;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    overflow: visible;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--nav-pill-bg);
    color: var(--text-muted);
    box-shadow: var(--shadow);
    cursor: pointer;
    pointer-events: auto;
    transition: color var(--t-fast) var(--ease-out), border-color var(--t-fast) var(--ease-out),
      transform var(--t-base) var(--ease-spring), box-shadow var(--t-base) var(--ease-out);
  }

  .music-player__toggle:hover {
    color: var(--brand);
    border-color: var(--brand);
    transform: translateY(-3px) scale(1.02);
    box-shadow: var(--shadow-lg);
  }

  .music-player__toggle:active {
    transform: translateY(-1px) scale(0.94);
  }

  .music-player.is-open .music-player__toggle {
    color: var(--brand);
    border-color: color-mix(in srgb, var(--brand) 55%, var(--border));
  }

  @supports ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
    .music-player__toggle,
    .music-player__panel {
      background: var(--glass-sheen), var(--glass-tint);
      border-color: var(--glass-rim-bottom);
      -webkit-backdrop-filter: var(--glass-backdrop);
      backdrop-filter: var(--glass-backdrop);
      box-shadow: var(--glass-inner-glow), var(--shadow-lg);
    }
  }

  .music-player__disc {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    overflow: hidden;
    border-radius: 50%;
    background:
      radial-gradient(circle at center, var(--surface) 0 9%, transparent 10% 20%, rgba(0, 0, 0, 0.32) 21%),
      repeating-radial-gradient(circle, #34373b 0 2px, #202226 3px 4px);
    color: rgba(255, 255, 255, 0.9);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
  }

  .music-player__disc::after {
    content: "";
    position: absolute;
    inset: 41%;
    z-index: 2;
    border-radius: 50%;
    background: var(--brand);
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.62);
  }

  .music-player__disc img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .music-player__disc-fallback {
    font-size: 1rem;
    line-height: 1;
  }

  .music-player__pulse {
    position: absolute;
    right: -0.18rem;
    bottom: 0.05rem;
    display: flex;
    align-items: flex-end;
    gap: 1px;
    height: 0.72rem;
    padding: 0.14rem 0.18rem;
    border: 2px solid var(--bg);
    border-radius: 999px;
    background: var(--brand);
    opacity: 0;
    transform: scale(0.7);
    transition: opacity var(--t-fast) var(--ease-out), transform var(--t-base) var(--ease-spring);
  }

  .music-player__pulse i {
    width: 2px;
    height: 0.22rem;
    border-radius: 99px;
    background: var(--button-text-on-accent);
  }

  .music-player.is-playing .music-player__pulse {
    opacity: 1;
    transform: scale(1);
  }

  .music-player__panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.75rem);
    display: flex;
    flex-direction: column;
    width: min(22.5rem, calc(100vw - 2rem));
    max-height: min(76vh, 39rem);
    overflow: hidden; /* 旧浏览器兜底 */
    overflow: clip; /* 不用 hidden：hidden 会自建滚动容器干扰滚轮；clip 视觉同上但不建容器 */
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    color: var(--text);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(0.75rem) scale(0.95);
    transform-origin: 92% 100%;
    transition: opacity var(--t-base) var(--ease-out-soft),
      transform var(--t-base) var(--ease-spring), visibility 0s linear var(--t-base);
  }

  .music-player.is-open .music-player__panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition-delay: 0s;
  }

  .music-player__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.1rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
  }

  .music-player__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand);
    font-size: 0.66rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.18em;
  }

  .music-player__header h2 {
    margin-top: 0.32rem;
    font-size: 1.12rem;
    letter-spacing: -0.015em;
  }

  .music-player__equalizer {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.68rem;
  }

  .music-player__equalizer i {
    width: 2px;
    border-radius: 99px;
    background: currentColor;
  }

  .music-player__equalizer i:nth-child(1) { height: 45%; }
  .music-player__equalizer i:nth-child(2) { height: 100%; }
  .music-player__equalizer i:nth-child(3) { height: 68%; }

  .music-player__header-actions {
    display: flex;
    gap: 0.25rem;
  }

  .music-player__header-actions :is(a, button),
  .music-player__controls button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--t-fast) var(--ease-out), background var(--t-fast) var(--ease-out),
      transform var(--t-fast) var(--ease-spring);
  }

  .music-player__header-actions :is(a, button):hover,
  .music-player__controls button:hover:not(:disabled) {
    color: var(--brand);
    background: var(--brand-soft);
  }

  .music-player__header-actions :is(a, button):active,
  .music-player__controls button:active:not(:disabled) {
    transform: scale(0.9);
  }

  .music-player__header-actions button {
    appearance: none;
  }

  .music-player__now {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem 0.8rem;
  }

  .music-player__cover {
    position: relative;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    overflow: hidden;
    border: 1px solid var(--edge);
    border-radius: 50%;
    background:
      radial-gradient(circle at center, var(--surface) 0 8%, transparent 9% 19%, rgba(0, 0, 0, 0.3) 20%),
      repeating-radial-gradient(circle, #3a3c41 0 3px, #222429 4px 6px);
    color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 8px 20px rgba(20, 24, 32, 0.14);
  }

  .music-player__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .music-player__cover-hole {
    position: absolute;
    inset: 42%;
    z-index: 2;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5), 0 0 0 4px rgba(0, 0, 0, 0.1);
  }

  .music-player__cover-fallback {
    font-size: 1.45rem;
  }

  .music-player__meta {
    min-width: 0;
  }

  .music-player__status {
    display: block;
    min-height: 1.25rem;
    margin-bottom: 0.18rem;
    color: var(--brand);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .music-player__meta strong,
  .music-player__meta > span:last-child {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .music-player__meta strong {
    font-size: 1rem;
    line-height: 1.45;
  }

  .music-player__meta > span:last-child {
    margin-top: 0.1rem;
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .music-player__timeline {
    padding: 0 1.1rem 0.2rem;
  }

  .music-player__timeline input {
    display: block;
    width: 100%;
    height: 1rem;
    margin: 0;
    accent-color: var(--brand);
    cursor: pointer;
  }

  .music-player__timeline input:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .music-player__time {
    display: flex;
    justify-content: space-between;
    margin-top: -0.05rem;
    color: var(--text-faint);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .music-player__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.28rem;
    padding: 0.2rem 1rem 0.9rem;
  }

  .music-player__controls button:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .music-player__controls .music-player__play {
    width: 2.85rem;
    height: 2.85rem;
    margin-inline: 0.15rem;
    background: var(--accent);
    color: var(--button-text-on-accent);
    box-shadow: var(--shadow-sm);
  }

  .music-player__controls .music-player__play:hover:not(:disabled) {
    background: var(--brand);
    color: var(--button-text-on-accent);
    transform: scale(1.05);
  }

  .music-player__play .music-player__play-icon {
    fill: currentColor;
    stroke: none;
    transform: translateX(1px);
  }

  .music-player .music-player__pause-icon,
  .music-player .music-player__muted-icon,
  .music-player.is-playing .music-player__play-icon,
  .music-player.is-muted .music-player__volume-icon {
    display: none;
  }

  .music-player.is-playing .music-player__pause-icon,
  .music-player.is-muted .music-player__muted-icon {
    display: block;
  }

  .music-player__queue-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 0.68rem 1.1rem 0.52rem;
    border-top: 1px solid var(--hairline);
  }

  .music-player__queue-head > span {
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .music-player__queue-head small {
    color: var(--text-faint);
    font-size: 0.72rem;
  }

  .music-player__queue {
    flex: 1 1 8rem;
    min-height: 4.15rem;
    max-height: 12.5rem;
    margin: 0;
    padding: 0 0.55rem;
    overflow-y: auto;
    /* 不设 overscroll-behavior: contain：滚轮统一由面板的 wheel 处理器接管（preventDefault + 手动滚列表），原生命中不了 */
    list-style: none;
    scrollbar-gutter: stable;
  }

  .music-player__empty {
    padding: 1.25rem 0.55rem 1.55rem;
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.6;
    text-align: center;
  }

  .music-player__track-button {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: center;
    width: 100%;
    gap: 0.55rem;
    padding: 0.58rem 0.55rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text);
    text-align: left;
    cursor: pointer;
    transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out);
  }

  .music-player__track-button:hover {
    background: var(--surface-muted);
  }

  .music-player__track-button[aria-current="true"] {
    background: var(--brand-soft);
  }

  .music-player__track-number {
    color: var(--text-faint);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .music-player__track-button[aria-current="true"] .music-player__track-number {
    color: var(--brand);
    font-weight: 800;
  }

  .music-player__track-copy {
    min-width: 0;
  }

  .music-player__track-copy strong,
  .music-player__track-copy small {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
