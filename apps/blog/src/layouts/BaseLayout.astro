---
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import Nav from '../components/Nav.astro';
import { ClientRouter } from 'astro:transitions';
import { defaultSchema } from 'rehype-sanitize';
import { getMdSanitizeLists } from 'cloud-blog/shared/md-sanitize-schema.mjs';
import { absoluteUrl, site } from '../lib/posts';
import { getSiteSettings } from '../lib/site-settings';
import '../styles/global.css';

// 客户端兜底净化的白名单与净化器共用同一份派生（shared/md-sanitize-schema），构建期序列化为 JSON
const mdSanitizeLists = getMdSanitizeLists(defaultSchema);

// 文章专属 OG 元数据（article:* 系列），仅文章页传入
interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: unknown;
  articleMeta?: ArticleMeta;
  /** 规范链接路径（如 /posts/{分类名}/{id}/）。同一篇文章存在旧地址时由页面传入，
   *  让旧地址那份产物把 canonical / og:url 指向新形态，避免搜索结果里两份重复内容 */
  canonicalPath?: string;
  /** 指示搜索引擎不要收录本页（旧 URL 形态的整页副本用 true，配合 canonical 去重） */
  noindex?: boolean;
}

// 站点信息：优先后台站点设置（SiteSettings），后台不可用时回退本地配置
const settings = await getSiteSettings();
const defaultInfo = {
  name: settings?.siteName ?? site.name,
  description: settings?.siteDescription ?? site.description,
  author: settings?.siteAuthor ?? site.author,
};

const {
  title = defaultInfo.name,
  description = defaultInfo.description,
  pageClass = '',
  image = '/share/og-default.jpg',
  type = 'website',
  jsonLd,
  articleMeta,
  canonicalPath,
  noindex = false,
} = Astro.props;

const pageTitle = title === defaultInfo.name ? title : `${title} - ${defaultInfo.name}`;
const canonicalUrl = absoluteUrl(canonicalPath ?? Astro.url.pathname);
const imageUrl = image ? absoluteUrl(image) : undefined;

// 评论服务地址：构建期 env 注入（PUBLIC_WALINE_URL），默认同域 /api/waline；经 meta 标签传给客户端脚本
const walineServer = import.meta.env.PUBLIC_WALINE_URL || '/api/waline';
let walineOrigin = '';
try {
  if (walineServer) walineOrigin = new URL(walineServer).origin;
} catch {
  walineOrigin = '';
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: defaultInfo.name,
  url: site.url,
  description: defaultInfo.description,
  inLanguage: 'zh-CN',
  author: { '@type': 'Person', name: defaultInfo.author, url: site.url },
};

const ldScripts = [websiteSchema, ...(jsonLd ? [jsonLd] : [])];

// Route motion is deliberately scoped to the page content. The site chrome
// stays still, and the outgoing content is nearly gone before the incoming
// content starts, so text never crossfades on top of text.
const routeMotion = {
  forwards: {
    old: {
      name: 'blogRouteOut',
      duration: '70ms',
      easing: 'cubic-bezier(0.4, 0, 1, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'blogRouteIn',
      duration: '130ms',
      delay: '70ms',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'blogRouteOut',
      duration: '70ms',
      easing: 'cubic-bezier(0.4, 0, 1, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'blogRouteIn',
      duration: '130ms',
      delay: '70ms',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html lang="zh-CN" transition:name="root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={defaultInfo.author} />
    <meta id="theme-color" name="theme-color" content="#fbf7ed" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/avatars/avatar.png" />
    <link rel="apple-touch-icon" href="/avatars/avatar.png" />
    {walineServer && <meta name="waline-server" content={walineServer} />}
    {walineOrigin && <link rel="preconnect" href={walineOrigin} crossorigin />}
    <link rel="preconnect" href="https://cravatar.cn" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+KuaiLe&display=swap"
    />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${defaultInfo.name} RSS`}
      href={absoluteUrl('/rss.xml')}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={defaultInfo.name} />
    <meta property="og:locale" content="zh_CN" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {articleMeta?.publishedTime && (
      <meta property="article:published_time" content={articleMeta.publishedTime} />
    )}
    {articleMeta?.modifiedTime && (
      <meta property="article:modified_time" content={articleMeta.modifiedTime} />
    )}
    {articleMeta?.section && <meta property="article:section" content={articleMeta.section} />}
    {articleMeta?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    {ldScripts.map((schema) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
      />
    ))}
    <ClientRouter />
    <script is:inline>
      (() => {
        const storageKey = 'blog-theme';
        const lightColor = '#fbf7ed';
        const darkColor = '#4a4034';
        const getTheme = () => {
          try {
            const stored = localStorage.getItem(storageKey);
            if (stored) return stored;
          } catch {
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        const restoreTheme = () => {
          const theme = getTheme();
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.add('js');
          document.querySelector('#theme-color')?.setAttribute(
            'content',
            theme === 'dark' ? darkColor : lightColor,
          );
        };

        restoreTheme();
        // ClientRouter swaps the <html> attributes. Restore the chosen theme
        // synchronously inside the swap callback, before the new frame paints.
        document.addEventListener('astro:after-swap', restoreTheme);
      })();
    </script>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">跳到正文</a>
    {pageClass === 'article-page' && (
      <div class="reading-progress" aria-hidden="true">
        <span data-reading-progress></span>
      </div>
    )}
    <Nav />
    <main id="main" transition:name="page-content" transition:animate={routeMotion}>
      <slot />
    </main>
    <Footer />
    <MusicPlayer />
    <button type="button" class="to-top" data-to-top aria-label="回到顶部">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 19V5M6 11l6-6 6 6" />
      </svg>
    </button>
    <script is:inline data-astro-rerun>
      (() => {
        window.__blogRevealController?.abort();
        const controller = new AbortController();
        window.__blogRevealController = controller;
        const signal = controller.signal;
        const sel =
          '.hero__intro > *, .hero__picks, .section__header, .section__more, .post-row, .related-posts, .post-nav, .article__header > *, .article__main > .article__cover, .proj-section__head, .proj, .page-header, .archive-summary, .archive-year__head, .about__intro > *, .note';

        // This fires inside ClientRouter's DOM-swap callback, before the browser
        // captures the incoming frame. It prevents the page-level fade from
        // snapshotting above-the-fold content in its hidden reveal state.
        const revealIncomingFrame = () => {
          // Route content already has one page-level entrance. Reveal every
          // incoming child before capture so the swap callback performs no
          // geometry reads and cannot extend the transition's blank interval.
          const visible = [...document.querySelectorAll(sel)];

          visible.forEach((el) => {
            el.style.transition = 'none';
            el.classList.add('is-revealed');
            el.dataset.revealed = '1';
          });

          window.requestAnimationFrame(() => {
            visible.forEach((el) => {
              el.style.transition = '';
            });
          });
        };
        document.addEventListener('astro:after-swap', revealIncomingFrame, { signal });

        const targets = [...document.querySelectorAll(sel)];

        if (!targets.length) {
          return;
        }

        // Position-based reveal: robust to fast scroll jumps, anchor links and
        // restored scroll (anything at/above the viewport reveals; off-screen
        // content that was jumped past simply appears without re-animating).
        let ticking = false;
        const routeSwap = document.documentElement.hasAttribute('data-astro-transition');
        const reveal = () => {
          ticking = false;
          const line = window.innerHeight * 0.94;
          const batch = [];
          for (const el of targets) {
            if (el.dataset.revealed) {
              continue;
            }
            if (el.getBoundingClientRect().top < line) {
              batch.push(el);
            }
          }
          // Stagger only the items that cross in together (e.g. the on-load batch).
          batch.forEach((el, index) => {
            if (routeSwap) {
              el.style.transition = 'none';
              window.requestAnimationFrame(() => {
                el.style.transition = '';
              });
            } else {
              el.style.setProperty('--reveal-delay', Math.min(index, 6) * 0.06 + 's');
            }
            el.classList.add('is-revealed');
            el.dataset.revealed = '1';
          });
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(reveal);
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true, signal });
        window.addEventListener('resize', onScroll, { passive: true, signal });
        window.addEventListener('load', reveal, { signal });
        window.requestAnimationFrame(reveal);
      })();
    </script>
    <script is:inline data-astro-rerun>
      (() => {
        // Mark article images once their bytes arrive so CSS can fade them in.
        document.querySelectorAll('.post-content img').forEach((img) => {
          const mark = () => img.classList.add('is-loaded');
          if (img.complete) {
            mark();
            return;
          }
          img.addEventListener('load', mark, { once: true });
          img.addEventListener('error', mark, { once: true });
        });
      })();
    </script>
    <script is:inline data-astro-rerun>
      window.__blogPageController?.abort();
      window.__blogPageController = new AbortController();

      (() => {
        const signal = window.__blogPageController.signal;
        const storageKey = 'blog-theme';
        const lightColor = '#f6efdd';
        const darkColor = '#2a2216';
        const button = document.querySelector('[data-theme-toggle]');
        const themeColor = document.querySelector('#theme-color');
        const getStoredTheme = () => {
          try {
            return localStorage.getItem(storageKey);
          } catch {
            return null;
          }
        };
        const setStoredTheme = (theme) => {
          try {
            localStorage.setItem(storageKey, theme);
          } catch {
          }
        };

        const getSystemTheme = () =>
          window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

        const applyTheme = (theme, persist = true) => {
          document.documentElement.dataset.theme = theme;
          themeColor?.setAttribute('content', theme === 'dark' ? darkColor : lightColor);

          if (button) {
            button.dataset.themeIcon = theme;
            button.setAttribute(
              'aria-label',
              theme === 'dark' ? '切换到浅色模式' : '切换到深色模式',
            );
            button.setAttribute('aria-pressed', String(theme === 'dark'));
          }

          if (persist) {
            setStoredTheme(theme);
          }
        };

        const currentTheme = () =>
          document.documentElement.dataset.theme || getStoredTheme() || getSystemTheme();

        // Inject literal percentages instead of px values or dynamic vars.
        // Chrome rasterizes view-transition snapshots at device-pixel density;
        // px clip coordinates can therefore render at half-size on a 2x screen,
        // leaving part of the viewport uncovered until the snapshot disappears.
        // Exact percentages stay in the snapshot's own coordinate space.
        const themeRevealStyle =
          document.getElementById('theme-reveal-style') ??
          (() => {
            const styleEl = document.createElement('style');
            styleEl.id = 'theme-reveal-style';
            document.head.append(styleEl);
            return styleEl;
          })();

        applyTheme(currentTheme(), false);

        const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
        let themeAnimTimer;
        let themeSwitching = false;
        button?.addEventListener('click', () => {
          if (themeSwitching) return;
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          const root = document.documentElement;

          // New theme sweeps out of the toggle as an expanding circle.
          if (
            motionOK &&
            document.startViewTransition &&
            !root.hasAttribute('data-astro-transition')
          ) {
            const rect = button.getBoundingClientRect();
            const x = rect.left + rect.width / 2;
            const y = rect.top + rect.height / 2;
            const radius =
              Math.hypot(
                Math.max(x, window.innerWidth - x),
                Math.max(y, window.innerHeight - y),
              ) + 20;
            const xPercent = (x / window.innerWidth) * 100;
            const yPercent = (y / window.innerHeight) * 100;
            // CSS resolves a circle's percentage radius against the normalized
            // diagonal: hypot(width, height) / sqrt(2).
            const radiusReference =
              Math.hypot(window.innerWidth, window.innerHeight) / Math.SQRT2;
            const radiusPercent = (radius / radiusReference) * 100;

            themeSwitching = true;
            button.classList.add('is-switching');
            themeRevealStyle.textContent = `@keyframes theme-reveal { from { clip-path: circle(0 at ${xPercent.toFixed(4)}% ${yPercent.toFixed(4)}%); } to { clip-path: circle(${radiusPercent.toFixed(4)}% at ${xPercent.toFixed(4)}% ${yPercent.toFixed(4)}%); } }`;
            root.classList.add('theme-vt');
            const vt = document.startViewTransition(() => applyTheme(next));
            vt.finished
              .catch(() => {})
              .finally(() => {
                themeSwitching = false;
                button.classList.remove('is-switching');
                root.classList.remove('theme-vt');
              });
            return;
          }

          applyTheme(next);
          if (motionOK) {
            root.classList.remove('theme-anim');
            void root.offsetWidth;
            root.classList.add('theme-anim');
            window.clearTimeout(themeAnimTimer);
            themeAnimTimer = window.setTimeout(() => root.classList.remove('theme-anim'), 380);
          }
        }, { signal });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
          if (!getStoredTheme()) {
            applyTheme(getSystemTheme(), false);
          }
        }, { signal });
      })();

      (() => {
        const signal = window.__blogPageController.signal;
        // 只用异步剪贴板 API（https/localhost 全支持）。不要再补 document.execCommand('copy') 兜底：
        // 该接口已废弃，且只为 http 非安全上下文而存在，走「复制失败」提示即可。
        const writeClipboard = async (text) => {
          if (!globalThis.navigator?.clipboard?.writeText) {
            return false;
          }

          await globalThis.navigator.clipboard.writeText(text);
          return true;
        };

        // 绑定文章正文交互（代码复制按钮 + 图片灯箱）。可安全重入：
        // 轮询脚本更新 postContent 后再次调用，保证新内容也带交互。
        const initPostContent = () => {
          // 代码复制按钮（已有 data-copy-code 标记防重）
          document.querySelectorAll('.post-content pre').forEach((pre) => {
            if (pre.querySelector('[data-copy-code]')) {
              return;
            }

            const code = pre.querySelector('code');
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'copy-code-button';
            button.dataset.copyCode = '';
            button.textContent = '复制';
            button.setAttribute('aria-label', '复制代码');
            pre.append(button);

            button.addEventListener('click', async () => {
              const text = code?.innerText ?? pre.innerText.replace(button.innerText, '');

              try {
                const copied = await writeClipboard(text.trimEnd());

                if (!copied) {
                  throw new Error('Copy command failed');
                }

                button.textContent = '已复制';
                button.classList.add('is-copied');
                window.setTimeout(() => {
                  button.textContent = '复制';
                  button.classList.remove('is-copied');
                }, 1800);
              } catch {
                button.textContent = '复制失败';
                window.setTimeout(() => {
                  button.textContent = '复制';
                }, 1800);
              }
            }, { signal });
          });

          // 图片灯箱（data-lightbox 标记防重，避免重复绑定点击）
          let overlay = null;

          const onKey = (event) => {
            if (event.key === 'Escape') {
              close();
            }
          };

          function close() {
            if (!overlay) {
              return;
            }

            const node = overlay;
            overlay = null;
            node.classList.remove('is-open');
            document.removeEventListener('keydown', onKey);
            window.setTimeout(() => node.remove(), 200);
          }

          const open = (source, alt) => {
            overlay = document.createElement('div');
            overlay.className = 'lightbox';
            overlay.setAttribute('role', 'dialog');
            overlay.setAttribute('aria-modal', 'true');
            overlay.setAttribute('aria-label', alt || '图片预览');

            const full = document.createElement('img');
            full.src = source;
            full.alt = alt || '';
            overlay.append(full);
            overlay.addEventListener('click', close, { signal });
            document.body.append(overlay);
            requestAnimationFrame(() => overlay?.classList.add('is-open'));
            document.addEventListener('keydown', onKey, { signal });
          };

          document.querySelectorAll('.post-content img:not(.legacy-inline-image)').forEach((image) => {
            if (image.dataset.lightbox) {
              return;
            }
            image.dataset.lightbox = '1';
            image.addEventListener(
              'click',
              () => {
                open(image.currentSrc || image.src, image.alt);
              },
              { signal },
            );
          });
        };

        // 暴露给轮询脚本：内容区块更新后重新绑定正文交互
        window.__blogInitPostContent = initPostContent;
        initPostContent();
      })();

      (() => {
        const signal = window.__blogPageController.signal;
        const bar = document.querySelector('[data-reading-progress]');
        const article = document.querySelector('.article');
        const toTop = document.querySelector('[data-to-top]');
        let ticking = false;

        const update = () => {
          ticking = false;
          const scrollY = window.scrollY;

          if (bar && article) {
            const start = article.offsetTop;
            const total = article.offsetHeight - window.innerHeight;
            const progress = total > 0 ? (scrollY - start) / total : 0;
            bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
          }

          if (toTop) {
            toTop.classList.toggle('is-visible', scrollY > 600);
          }
        };

        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(update);
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true, signal });
        window.addEventListener('resize', onScroll, { passive: true, signal });
        update();

        toTop?.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }, { signal });
      })();

      (() => {
        const signal = window.__blogPageController.signal;
        const links = [...document.querySelectorAll('.toc a[href^="#"]')];

        if (!links.length) {
          return;
        }

        const items = links
          .map((link) => {
            const id = decodeURIComponent(link.getAttribute('href').slice(1));
            return { link, heading: document.getElementById(id) };
          })
          .filter((item) => item.heading);

        if (!items.length) {
          return;
        }

        let current = null;
        const setActive = (link) => {
          if (current === link) {
            return;
          }
          current?.classList.remove('is-active');
          link.classList.add('is-active');
          current = link;
        };

        let ticking = false;
        const sync = () => {
          ticking = false;
          const offset = 130;
          let active = items[0].link;
          for (const { link, heading } of items) {
            if (heading.getBoundingClientRect().top <= offset) {
              active = link;
            } else {
              break;
            }
          }
          // When scrolled to the bottom, the last headings may never pass the
          // offset threshold (page runs out of scroll). Force the last item active.
          if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 60) {
            active = items[items.length - 1].link;
          }
          setActive(active);
        };

        window.addEventListener(
          'scroll',
          () => {
            if (!ticking) {
              ticking = true;
              window.requestAnimationFrame(sync);
            }
          },
          { passive: true, signal },
        );
        sync();
      })();
    </script>
    <!-- 客户端净化白名单数据：与服务端净化链同源（shared/md-sanitize-schema），走 set:html 注入（同 JSON-LD 用法），内联脚本里不能写模板表达式 -->
    <script is:inline data-astro-rerun set:html={`window.__mdSanitizeLists=${JSON.stringify(mdSanitizeLists).replace(/</g, '\\u003c')};`}></script>
    <script is:inline data-astro-rerun>
      (() => {
        // 后台数据实时同步：SSE 为主通道（近实时推送），轮询为兜底（30s 间隔）。
        // 使用 data-astro-rerun，路由切换（ClientRouter 换页）后自动重新初始化。
        window.__blogSyncController?.abort();
        const controller = new AbortController();
        window.__blogSyncController = controller;
        const signal = controller.signal;

        // 同步配置常量（集中定义避免魔法值散落在逻辑中）
        const KEY = 'blog-data-version';
        const SSE_STREAM_URL = '/api/blog-sync/stream';
        const POLL_URL = '/api/blog-sync';
        const SSE_TIMEOUT_MS = 30_000;
        const POLL_INTERVAL_MS = 30_000;
        // SSE 断开后的重连退避：服务端会周期性回收连接（单连接存活上限），
        // 所以断开是正常事件，必须真重连，而不是永远退化成轮询。
        const SSE_RETRY_MS = 5_000;
        const SSE_RETRY_MAX_MS = 60_000;
        // 滚动显现（scroll reveal）目标：新插入的 DOM 默认无 is-revealed 会隐藏，
        // 需要手动补类，保证同步更新后的内容立即可见
        const REVEAL_SEL = [
          '.hero__intro > *', '.hero__picks',
          '.section__header', '.section__more', '.post-row',
          '.related-posts', '.post-nav', '.article__header > *', '.article__main > .article__cover',
          '.proj-section__head', '.proj',
          '.page-header', '.archive-summary', '.archive-year__head',
          '.about__intro > *', '.note',
        ].join(', ');

        // 客户端兜底净化：区块 HTML 已在服务端渲染链（blog-render + rehype-sanitize）白名单净化过，
        // 这里只挡「服务端净化被绕过 / API 响应被篡改」两类残余风险，故改为白名单逐节点过滤：
        // tags/attrs/URL 属性/协议集合由 shared/md-sanitize-schema 与净化器同源派生、构建期注入。
        // DOMParser 只负责解析输入字符串；输出经 createElement/importNode 挂回文档片段，
        // 不再 innerHTML 二次序列化，收窄 mXSS（解析器差异利用）面。
        const SAN = window.__mdSanitizeLists ?? {};
        const TAGS = new Set(SAN.tags);
        // 这些标签即便不在白名单也整棵子树丢弃（unwrap 会把脚本内容变成可见文本节点）
        const DROP_SUBTREE = new Set(['script', 'style', 'object', 'embed', 'frame', 'form', 'template', 'noscript', 'svg', 'math']);
        const URL_ATTRS = new Set(SAN.urlAttributes);
        const HREF_PROTOCOLS = new Set(SAN.protocols?.href ?? []);
        const SRC_PROTOCOLS = new Set(SAN.protocols?.src ?? []);
        const IFRAME_HOSTS = (SAN.iframeHosts ?? []).map((h) => String(h).toLowerCase());
        const ATTR_SETS = new Map(Object.entries(SAN.attributes ?? {}).map(([t, names]) => [t, new Set(names)]));
        const attrAllowed = (tag, name) =>
          ATTR_SETS.get(tag)?.has(name) || ATTR_SETS.get('*')?.has(name) || /^data-[\w.-]+$/.test(name);

        const compactUrl = (raw) => String(raw).replace(/[\u0000-\u0020]/g, '');
        const urlOk = (raw, attr) => {
          const compact = compactUrl(raw);
          if (!compact) return true;
          // 协议相对 //host 与反斜杠伪装（\\host）一律拒绝（与 shared/html-safety 红线一致），只放行单斜杠/普通相对路径
          if (compact.startsWith('//') || compact.includes('\\')) return false;
          if (attr === 'srcset') {
            return compact.split(',').every((candidate) => urlOk(candidate.trim().split(/\s+/)[0] ?? '', attr));
          }
          const scheme = compact.match(/^([a-zA-Z][a-zA-Z0-9+.-]*):/);
          if (!scheme) return true;
          return (attr === 'href' ? HREF_PROTOCOLS : SRC_PROTOCOLS).has(scheme[1].toLowerCase());
        };
        const iframeSrcOk = (raw) => {
          let host = '';
          try {
            host = new URL(compactUrl(raw)).hostname.toLowerCase();
          } catch {
            return false;
          }
          return IFRAME_HOSTS.some((h) => host === h || host.endsWith(`.${h}`));
        };

        // 白名单递归过滤：非白名单标签 unwrap 保留子内容；输出直接建在主文档上（无需 importNode 跨文档）
        const cleanChildren = (source) => {
          const frag = document.createDocumentFragment();
          for (const child of Array.from(source.childNodes)) {
            if (child.nodeType === Node.TEXT_NODE) {
              frag.appendChild(document.importNode(child, false));
              continue;
            }
            if (child.nodeType !== Node.ELEMENT_NODE) continue; // 注释/其它节点：丢弃
            const tag = child.tagName.toLowerCase();
            if (DROP_SUBTREE.has(tag)) continue;
            if (tag === 'iframe') {
              const src = child.getAttribute('src') ?? '';
              // 非白名单 host 的 iframe 整节点丢弃（服务端 schema 此时已剥 src，这里兜住篡改后的响应）
              if (!urlOk(src, 'src') || !iframeSrcOk(src)) continue;
            }
            if (!TAGS.has(tag)) {
              frag.appendChild(cleanChildren(child));
              continue;
            }
            const el = document.createElement(tag);
            for (const attr of Array.from(child.attributes)) {
              const name = attr.name.toLowerCase();
              if (name.startsWith('on')) continue;
              if (!attrAllowed(tag, name)) continue;
              if (URL_ATTRS.has(name) && !urlOk(attr.value, name)) continue;
              // style 不再全放行：url()/expression/behavior 这类可外联或可执行的写法整体丢弃该属性
              if (name === 'style' && /url\s*\(|expression\s*\(|javascript:|behavior\s*:/i.test(compactUrl(attr.value))) continue;
              el.setAttribute(attr.name, attr.value);
            }
            el.appendChild(cleanChildren(child));
            frag.appendChild(el);
          }
          return frag;
        };
        const sanitizeBlock = (html) => {
          const doc = new DOMParser().parseFromString(`<body>${html}</body>`, 'text/html');
          return cleanChildren(doc.body);
        };

        // 更新某个锚点的内容；找不到锚点或内容为空则跳过，返回是否更新成功
        // 用原始 HTML 字符串做「这块真变了没」的比较，替代旧的 innerHTML 往返对比（不再需要序列化）
        const lastAppliedHtml = new WeakMap();
        const applyBlock = (id, html, version) => {
          if (html == null || html === '') return false;
          const el = document.querySelector(`[data-sync-block="${id}"]`);
          if (!el) return false;
          // 服务端在返回 HTML 时已经用**同一版本号**注入过这一块 → 直接跳过。
          // 否则首次同步会把刚渲染好的同一份内容再重写一遍，白白的闪烁 + 重排。
          if (version && el.dataset.syncVersion === version) return false;
          if (lastAppliedHtml.get(el) === String(html)) {
            if (version) el.dataset.syncVersion = version;
            return false; // 内容相同无需重写
          }
          lastAppliedHtml.set(el, String(html));
          el.replaceChildren(sanitizeBlock(html));
          if (version) el.dataset.syncVersion = version;
          // 新内容补 reveal 类，避免被「未显现隐藏」规则遮住
          el.querySelectorAll(REVEAL_SEL).forEach((node) => {
            node.classList.add('is-revealed');
            node.dataset.revealed = '1';
          });
          return true;
        };

        // 页面加载后的首次同步必须无条件应用区块：
        // 刷新后页面可能是构建时的静态快照（落后于后台最新数据），
        // 而 localStorage 里往往已存有最新版本号；若首次也跳过，
        // 会出现「刷新后回退成旧内容」的问题。
        // 注：服务端注入（[[...path]]/route.ts）后，正常情况下首次同步会因
        // 版本号一致而全部跳过 DOM 写入，页面首屏已经是后台最新数据，不再闪烁。
        let firstSync = true;

        // 单次同步：请求最新区块并对比版本号
        const sync = async () => {
          try {
            const path = window.location.pathname;
            const res = await fetch(
              `${POLL_URL}?path=${encodeURIComponent(path)}`,
              { signal, cache: 'no-store' },
            );
            if (!res.ok) return;
            const data = await res.json();
            if (!data || typeof data.version !== 'string') return;

            let stored = null;
            try {
              stored = localStorage.getItem(KEY);
            } catch {}
            // 仅在非首次同步时用版本号判断「无变化」
            if (!firstSync && stored === data.version) return;
            firstSync = false;

            const blocks = data.blocks || {};
            let updatedAny = false;
            for (const [id, html] of Object.entries(blocks)) {
              const applied = applyBlock(id, html, data.version);
              updatedAny = updatedAny || applied;
            }
            if (data.title && document.title !== data.title) {
              document.title = data.title;
            }
            // 正文被替换后，重新绑定复制按钮/图片灯箱等交互
            if (updatedAny) {
              if (window.__blogInitPostContent) {
                window.__blogInitPostContent();
              }
              // 通知页面级脚本（如归档页「展开其余标签」）重新绑定
              document.dispatchEvent(new CustomEvent('blog:sync-updated'));
            }
            try {
              localStorage.setItem(KEY, data.version);
            } catch {}
          } catch (err) {
            if (err?.name === 'AbortError') return;
            // 网络失败静默重试，避免控制台刷屏
          }
        };

        // ---- update 事件防抖：抖动打散 + 同 tick 合并 ----
        // 后台一次保存会让所有打开的标签页同时收到 SSE update；不齐步地各自全区块重拉，
        // 会把瞬时请求放大成 N 个并发慢请求（单用户多标签页也能观察到）。
        let syncQueued = false;
        let syncQueueTimer = 0;
        const scheduleSync = () => {
          if (syncQueued || document.hidden) return;
          syncQueued = true;
          const delay = 300 + Math.random() * 1700;
          syncQueueTimer = window.setTimeout(() => {
            syncQueued = false;
            if (document.hidden) return; // 回可见时由 visibilitychange 立即补一次 sync
            void sync();
          }, delay);
        };

        // ---- SSE 主通道 + 轮询兜底 ----
        // 首次加载立即同步一次，确保首屏数据是最新的
        sync();

        let sseSource = null;
        let pollTimer = null;
        let sseEstablished = false;
        let handshakeTimer = null;
        let reconnectTimer = null;
        let reconnectDelayMs = SSE_RETRY_MS;

        const clearHandshakeTimer = () => {
          if (handshakeTimer) {
            window.clearTimeout(handshakeTimer);
            handshakeTimer = null;
          }
        };

        const clearReconnectTimer = () => {
          if (reconnectTimer) {
            window.clearTimeout(reconnectTimer);
            reconnectTimer = null;
          }
        };

        // 启动轮询兜底（SSE 不可用或超时后调用）；隐藏标签页不轮询，回可见时再恢复
        const startPolling = () => {
          if (pollTimer || document.hidden) return;
          pollTimer = window.setInterval(sync, POLL_INTERVAL_MS);
        };

        // 停止轮询（SSE 建立后调用）
        const stopPolling = () => {
          if (pollTimer) {
            window.clearInterval(pollTimer);
            pollTimer = null;
          }
        };

        // 退避重连：服务端会按存活上限主动回收连接，断开是常态而非终点；隐藏期间不排重连
        const scheduleReconnect = () => {
          if (reconnectTimer || document.hidden) return;
          const delay = reconnectDelayMs;
          reconnectDelayMs = Math.min(reconnectDelayMs * 2, SSE_RETRY_MAX_MS);
          reconnectTimer = window.setTimeout(() => {
            reconnectTimer = null;
            connectSse();
          }, delay);
        };

        // 尝试连接 SSE 流：收到 update 事件时触发一次 sync，建立后停止轮询
        const connectSse = () => {
          if (sseSource) return;
          try {
            sseSource = new EventSource(SSE_STREAM_URL, { withCredentials: false });
          } catch {
            startPolling();
            scheduleReconnect();
            return;
          }

          // 每次只认当前这一个连接：否则旧的超时定时器会误杀之后新建的连接
          const source = sseSource;
          sseEstablished = false;

          // 超时：若 SSE 未能建立稳定连接则先降级为轮询，稍后仍会重试（代理可能只是慢）
          clearHandshakeTimer();
          handshakeTimer = window.setTimeout(() => {
            handshakeTimer = null;
            if (sseEstablished || sseSource !== source) return;
            source.close();
            sseSource = null;
            startPolling();
            scheduleReconnect();
          }, SSE_TIMEOUT_MS);

          source.addEventListener('open', () => {
            sseEstablished = true;
            reconnectDelayMs = SSE_RETRY_MS;
            clearHandshakeTimer();
            clearReconnectTimer();
            stopPolling();
          });

          source.addEventListener('update', () => {
            scheduleSync();
          });

          source.addEventListener('error', () => {
            // 断开（含服务端回收、代理空闲切断）：轮询先兜底，同时退避重连。
            // 只降级不重连会让页面在一次断开后永久停在 30s 轮询上。
            clearHandshakeTimer();
            source.close();
            if (sseSource === source) sseSource = null;
            sseEstablished = false;
            startPolling();
            scheduleReconnect();
          });
        };

        connectSse();

        // 隐藏标签页：断开 SSE、停掉轮询与一切重连排程（省后台连接），回可见时立即 sync 并重连。
        // 重连/退避本身逻辑不变，只是隐藏期间冻结。
        const onVisibility = () => {
          if (document.hidden) {
            window.clearTimeout(syncQueueTimer);
            syncQueued = false;
            stopPolling();
            clearHandshakeTimer();
            clearReconnectTimer();
            sseSource?.close();
            sseSource = null;
            sseEstablished = false;
            return;
          }
          void sync();
          connectSse();
        };
        document.addEventListener('visibilitychange', onVisibility);

        signal.addEventListener('abort', () => {
          document.removeEventListener('visibilitychange', onVisibility);
          window.clearTimeout(syncQueueTimer);
          clearHandshakeTimer();
          clearReconnectTimer();
          sseSource?.close();
          sseSource = null;
          if (pollTimer) window.clearInterval(pollTimer);
          pollTimer = null;
        });
      })();
    </script>
    <script is:inline>
      // This site ships no service worker. Sweep out any registration left by
      // a previous site generation (or another project on this localhost port)
      // — a stale SW serves outdated CSS/JS and breaks page transitions.
      (() => {
        if (!('serviceWorker' in navigator)) return;
        navigator.serviceWorker
          .getRegistrations()
          .then((regs) => {
            if (!regs.length) return;
            regs.forEach((reg) => reg.unregister());
            if (window.caches) {
              caches.keys().then((keys) => keys.forEach((key) => caches.delete(key)));
            }
          })
          .catch(() => {});
      })();
    </script>
    <script is:inline>
      (() => {
        const isTyping = (el) =>
          el &&
          (el.tagName === 'INPUT' ||
            el.tagName === 'TEXTAREA' ||
            el.tagName === 'SELECT' ||
            el.isContentEditable);

        document.addEventListener('keydown', (event) => {
          const slash =
            event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey;
          const cmdK =
            (event.metaKey || event.ctrlKey) && (event.key === 'k' || event.key === 'K');

          if (!slash && !cmdK) {
            return;
          }
          if (slash && isTyping(document.activeElement)) {
            return;
          }

          event.preventDefault();
          const input = document.querySelector('#search-input');

          if (input) {
            input.focus();
            input.select?.();
          } else {
            window.location.href = '/search/';
          }
        });
      })();
    </script>
  </body>
</html>
