---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="搜索"
  description="搜索站内的文章、随笔、项目、分类和标签。"
  pageClass="content-page"
>
  <section class="search-page">
    <header class="page-header">
      <p class="eyebrow">Search</p>
      <h1>搜索站内内容</h1>
      <p>
        输入关键词，快速找到标题、摘要、分类或标签匹配的内容。日常搜索请用导航上的搜索按钮（/ 或
        ⌘K）唤起的浮层，本页是浮层不可用时的兜底。
      </p>
    </header>

    <form class="search-box" role="search">
      <label for="search-input">关键词</label>
      <div class="search-box__control">
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="Cursor、部署、Midjourney..."
          autocomplete="off"
        />
        <button type="submit">搜索</button>
      </div>
    </form>

    <p class="search-status" data-search-status>正在加载索引...</p>
    <div class="search-results post-list" data-search-results></div>
  </section>

  <script>
    import {
      KIND_LABEL,
      SITE_INDEX_URL,
      escapeHtml,
      groupHits,
      highlight,
      searchEntries,
      splitTerms,
      type IndexEntry,
      type SearchHit,
    } from '../lib/search-match';

    type SearchPageState = { bound: boolean; entries: IndexEntry[] | null };

    // 换页后模块脚本不重放，但状态留在 window 上：索引只拉一次
    const state: SearchPageState = (
      window as Window & { __blogSearchPage?: SearchPageState }
    ).__blogSearchPage ??= { bound: false, entries: null };

    const inputOf = () => document.querySelector<HTMLInputElement>('#search-input');
    const statusOf = () => document.querySelector<HTMLElement>('[data-search-status]');
    const resultsOf = () => document.querySelector<HTMLElement>('[data-search-results]');

    function rowMarkup(hit: SearchHit, terms: string[]): string {
      const { entry } = hit;
      const tags = entry.tags
        .slice(0, 4)
        .map((tag) => `<span>${escapeHtml(tag)}</span>`)
        .join('');

      return `<article class="post-row post-row--plain is-revealed"><a href="${escapeHtml(entry.url)}"><div class="post-row__main"><div class="post-meta"><span>${escapeHtml(KIND_LABEL[entry.kind])}</span>${entry.meta ? `<span>${escapeHtml(entry.meta)}</span>` : ''}</div><h3>${highlight(entry.title, terms)}</h3>${entry.subtitle ? `<p>${highlight(entry.subtitle, terms)}</p>` : ''}${tags ? `<div class="tag-list" aria-label="标签">${tags}</div>` : ''}</div></a></article>`;
    }

    function render(query: string): void {
      const status = statusOf();
      const results = resultsOf();
      if (!status || !results) return;

      if (state.entries === null) {
        status.textContent = '正在加载索引...';
        results.innerHTML = '';
        return;
      }

      const terms = splitTerms(query);

      if (terms.length === 0) {
        status.textContent = `已索引 ${state.entries.length} 条站内内容。`;
        results.innerHTML = '';
        return;
      }

      const groups = groupHits(searchEntries(state.entries, query));
      const total = groups.reduce((sum, group) => sum + group.hits.length, 0);

      status.textContent = total ? `找到 ${total} 条相关内容。` : '没有找到相关内容。';
      results.innerHTML = groups
        .map(
          (group) =>
            `<p class="search-group">${escapeHtml(KIND_LABEL[group.kind])}</p>` +
            group.hits.map((hit) => rowMarkup(hit, terms)).join(''),
        )
        .join('');
    }

    function syncUrl(query: string): void {
      const nextUrl = new URL(window.location.href);

      if (query) {
        nextUrl.searchParams.set('q', query);
      } else {
        nextUrl.searchParams.delete('q');
      }

      window.history.replaceState({}, '', nextUrl);
    }

    function runSearch(): void {
      const input = inputOf();
      if (!input) return;
      const query = input.value.trim();
      syncUrl(query);
      render(query);
    }

    // 换页回到本页时输入框是空的，按 URL 上的 ?q= 复原
    function restoreFromUrl(): void {
      const input = inputOf();
      if (!input) return;
      const query = new URLSearchParams(window.location.search).get('q') ?? '';
      input.value = query;
      render(query);
    }

    if (!state.bound) {
      state.bound = true;

      document.addEventListener('submit', (event) => {
        if (event.target instanceof HTMLFormElement && event.target.matches('.search-box')) {
          event.preventDefault();
          runSearch();
        }
      });

      document.addEventListener('input', (event) => {
        const field = event.target;
        if (field instanceof HTMLInputElement && field.id === 'search-input') {
          runSearch();
        }
      });

      document.addEventListener('astro:after-swap', restoreFromUrl);
    }

    fetch(SITE_INDEX_URL)
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json() as Promise<IndexEntry[]>;
      })
      .then((items) => {
        state.entries = items;
        restoreFromUrl();
      })
      .catch(() => {
        const status = statusOf();
        if (status) status.textContent = '搜索索引加载失败。';
      });
  </script>
</BaseLayout>
