---
import { getCollection, type CollectionEntry } from 'astro:content';
import Icon from '../components/Icon.astro';
import SkillRing from '../components/SkillRing.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortPosts } from '../lib/posts';
import { getAboutContent } from '../lib/site-settings';

const posts = sortPosts(await getCollection('posts'));
const postCount = posts.length;
const firstYear = posts.reduce((min, post) => {
  const year = post.data.date?.getFullYear();
  return year && year < min ? year : min;
}, new Date().getFullYear());

// 关于页正文/便签/技能：优先后台站点设置（可随时在后台修改），缺失时回退默认值
const about = await getAboutContent();

// ---- 项目：全部来自 Payload 后台 projects 集合，构建时载入 ----
// loader 已按 sortOrder 升序写入 store，分组时保持该顺序
const projects = await getCollection('projects');

// 分组聚合：镜像后台 blog-render.tsx 的 groupProjects()——
// 保留首次出现的分组描述，组内顺序即 sortOrder 顺序
const projectGroups = (() => {
  const order: string[] = [];
  const byGroup = new Map<string, { description: string; items: CollectionEntry<'projects'>[] }>();
  for (const p of projects) {
    if (!byGroup.has(p.data.group)) {
      byGroup.set(p.data.group, { description: p.data.groupDescription ?? '', items: [] });
      order.push(p.data.group);
    }
    byGroup.get(p.data.group)!.items.push(p);
  }
  return order.map((title) => {
    const g = byGroup.get(title)!;
    return { title, description: g.description, items: g.items.map((entry) => entry.data) };
  });
})();

// 实心星星（项目 Star 数）：内联 SVG，与后台渲染的 STAR_FILL_SVG 逐字一致
const STAR_FILL_SVG =
  '<svg class="proj__stars-icon" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>';
---

<BaseLayout
  title="关于"
  description="关于段枫，以及这个完全由 AI 开发的博客会持续记录的内容。"
  pageClass="content-page"
>
  <article class="about">
    <!-- 关于我：左文字 + 右便签（运行时同步区块） -->
    <section class="about__profile" aria-labelledby="about-heading" data-sync-block="aboutProfile">
      <div class="about__intro-card">
        <span class="about__eyebrow">ABOUT</span>
        <h1 id="about-heading" class="about__lead">
          {about.lead}
        </h1>
        {about.paragraphs.map((paragraph) => (
          <p class="about__text" set:html={paragraph} />
        ))}
        <div class="about__facts">
          <span class="about__fact">{postCount} 篇文章</span>
          <span class="about__fact">写于 {firstYear} 至今</span>
          <span class="about__fact">全站由 AI 开发</span>
        </div>
      </div>

      <div class="about__notes">
        {about.notes.map((note) => (
          <div class={`about__note about__note--${note.color}`}>
            <span class="about__note-tape" aria-hidden="true"></span>
            <strong>{note.title}</strong>
            <span>{note.subtitle}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- 我的小本领（运行时同步区块） -->
    <section class="about__skills" aria-labelledby="skills-heading" data-sync-block="aboutSkills">
      <div class="section__header">
        <h2 id="skills-heading">我的小本领</h2>
      </div>
      <div class="skill-grid">
        {about.skills.map((skill) => <SkillRing {...skill} />)}
      </div>
    </section>

    <!-- 项目区（运行时同步区块）
         后端返回多个 .proj-section（无统一根节点），用 display:contents 的
         透明锚点承载，子元素仍按 .about 直接子级参与布局 -->
    <div data-sync-block="aboutProjects" style="display: contents">
      {projectGroups.map((section) =>
        section.items.length > 0 ? (
          <section class="proj-section" aria-labelledby={`${section.title}-heading`}>
            <div class="proj-section__head">
              <h2 class="proj-section__label" id={`${section.title}-heading`}>{section.title}</h2>
              <p class="proj-section__desc">{section.description}</p>
            </div>

            <div class="proj-grid">
              {section.items.map((item) => (
                <article class="proj">
                  <span class="proj__icon"><Icon name={item.icon} size={18} /></span>
                  <div class="proj__body">
                    <span class="proj__owner">
                      {item.owner ?? ''}
                      {item.stars > 0 && (
                        <span class="proj__stars">
                          <Fragment set:html={STAR_FILL_SVG} />
                          {item.stars}
                        </span>
                      )}
                    </span>
                    <h3 class="proj__title">
                      <a
                        href={item.href ?? '#'}
                        target={item.href?.startsWith('http') ? '_blank' : undefined}
                        rel={item.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
                      >
                        {item.title}
                        <Icon name="arrow-up-right" size={16} class="proj__go" />
                      </a>
                    </h3>
                    <p class="proj__desc">{item.description ?? ''}</p>
                    <div class="proj__foot">
                      <span class="proj__tags">
                        {(item.tags ?? []).map((tag) => <small>{tag}</small>)}
                      </span>
                      {item.articleHref && (
                        <a class="proj__note" href={item.articleHref}>
                          笔记
                          <Icon name="arrow-right" size={13} />
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ) : null
      )}
    </div>
  </article>
</BaseLayout>
