---
import { getCollection } from 'astro:content';
import Icon from '../components/Icon.astro';
import PostSummary from '../components/PostSummary.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHero, getSiteSettings, parseSocials } from '../lib/site-settings';
import {
  formatDate,
  getPostCategory,
  getPostCover,
  getPostDescription,
  site,
  sortPosts,
  sortPostsByDate,
} from '../lib/posts';

const posts = sortPosts(await getCollection('posts'));
const featuredPosts = posts.filter((post) => (post.data.sticky ?? 0) > 0);
const latestPosts = sortPostsByDate(posts).slice(0, 8);

// Hero "精选" picks: sticky posts first, topped up with the latest, max 3.
const heroPicks = [
  ...featuredPosts,
  ...latestPosts.filter((post) => !featuredPosts.some((f) => f.id === post.id)),
].slice(0, 5);

// Hero 文案与社交链接：优先读取后台站点设置，后台不可用时回退默认值
const settings = await getSiteSettings();
const hero = await getHero();
const heroBio = hero.bio.replace('{count}', String(posts.length));

const defaultSocials = [
  { platform: 'bilibili', href: 'https://space.bilibili.com/46377861', label: 'Bilibili' },
  { platform: 'douyin', href: 'https://www.douyin.com/user/self', label: '抖音' },
  { platform: 'youtube', href: 'https://www.youtube.com/channel/UCUuwwXFGK8Z3OBrq6PzkmUg', label: 'YouTube' },
  { platform: 'x', href: 'https://x.com/shenfanlaogou', label: 'X' },
  { platform: 'rss', href: '/rss.xml', label: 'RSS 订阅' },
];
/** 平台 → Icon 图标名映射 */
const socialIconMap: Record<string, string> = {
  bilibili: 'bilibili',
  douyin: 'douyin',
  youtube: 'youtube',
  x: 'x-platform',
  rss: 'rss',
};
const socials = (() => {
  // 后台社交链接是 textarea（每行「平台 链接」），解析为数组；为空回退默认
  const items = parseSocials(settings?.socials).map((item) => ({ ...item, label: item.platform }));
  const src = items.length > 0 ? items : defaultSocials;
  return src.map((item) => ({ ...item, icon: socialIconMap[item.platform] })).filter((item) => item.href && item.icon);
})();

// Warm clay/amber band for cover-less featured items, on palette.
// 站点名：与 BaseLayout 保持一致，优先后台设置
const siteName = settings?.siteName ?? site.name;

const coverHue = (value: string) => {
  let hash = 0;
  for (const char of value) {
    hash = (hash * 31 + char.charCodeAt(0)) % 360;
  }
  return 12 + (hash % 32);
};

---

<BaseLayout title={siteName} description={site.description} pageClass="home-page">
  <section class="hero">
    <div class="hero__card">
      <!-- 手绘箭头装饰 -->
      <span class="hero__arrow" aria-hidden="true"></span>
      <!-- 黄色圆点贴纸 -->
      <span class="hero__sticker hero__sticker--1" aria-hidden="true"></span>
      <span class="hero__sticker hero__sticker--2" aria-hidden="true"></span>

      <h1 class="hero__title">
        {hero.greeting}<span class="hero__name">{hero.name}</span>！
      </h1>
      <p class="hero__subtitle">{hero.subtitle}</p>
      <p class="hero__bio">{heroBio}</p>

      <div class="hero__actions">
        <a class="hero__tag" href="/archive/">
          {hero.buttonLabel}
          <Icon name="arrow-right" size={16} />
        </a>
        <span class="hero__social" aria-label="社交链接">
          {socials.map((item) => (
            <a
              class="icon-button"
              href={item.href}
              target={item.href.startsWith('http') ? '_blank' : undefined}
              rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={item.label}
            >
              <Icon name={item.icon} />
            </a>
          ))}
        </span>
      </div>
    </div>

    {heroPicks.length > 0 && (
      <aside class="hero__picks" aria-label="精选文章">
        <p class="hero__picks-label">精选</p>
        <div class="picks">
          <a class="pick-hero" href={`/posts/${heroPicks[0].id}/`}>
            {getPostCover(heroPicks[0]) ? (
              <span class="pick-hero__thumb">
                <img
                  src={getPostCover(heroPicks[0])}
                  alt=""
                  loading="eager"
                  fetchpriority="high"
                  referrerpolicy="no-referrer"
                />
              </span>
            ) : (
              <span
                class="pick-hero__thumb pick__thumb--fallback"
                style={`--h:${coverHue(heroPicks[0].data.title)}`}
              />
            )}
            <span class="post-meta">
              {getPostCategory(heroPicks[0]) && <span>{getPostCategory(heroPicks[0])}</span>}
              {heroPicks[0].data.date && (
                <time datetime={heroPicks[0].data.date.toISOString()}>
                  {formatDate(heroPicks[0].data.date)}
                </time>
              )}
            </span>
            <span class="pick-hero__title">{heroPicks[0].data.title}</span>
            <span class="pick-hero__desc">{getPostDescription(heroPicks[0])}</span>
          </a>

          {heroPicks.length > 1 && (
            <ul class="pick-side">
              {heroPicks.slice(1, 5).map((post) => (
                <li>
                  <a class="pick-side__item" href={`/posts/${post.id}/`}>
                    {getPostCover(post) ? (
                      <span class="pick-side__thumb">
                        <img src={getPostCover(post)} alt="" loading="lazy" referrerpolicy="no-referrer" />
                      </span>
                    ) : (
                      <span
                        class="pick-side__thumb pick__thumb--fallback"
                        style={`--h:${coverHue(post.data.title)}`}
                      />
                    )}
                    <span class="pick-side__text">
                      <span class="pick-side__title">{post.data.title}</span>
                      {post.data.date && (
                        <time class="pick-side__date" datetime={post.data.date.toISOString()}>
                          {formatDate(post.data.date)}
                        </time>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </aside>
    )}
  </section>


  <section class="section">
    <div class="section__header section__header--row">
      <div>
        <h2>最新文章</h2>
        <p>持续更新 AI、开发和建站相关笔记。</p>
      </div>
      <a class="section__more" href="/archive/">
        全部 {posts.length} 篇
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="post-list" aria-label="文章列表">
      {latestPosts.map((post) => <PostSummary post={post} />)}
    </div>
  </section>
</BaseLayout>
