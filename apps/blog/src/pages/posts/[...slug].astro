---
import { getCollection, render } from 'astro:content';
import CommentsBox from '../../components/CommentsBox.astro';
import Icon from '../../components/Icon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteSettings } from '../../lib/site-settings';
import {
  absoluteUrl,
  formatDate,
  getAdjacentPosts,
  getPostCategory,
  getPostCover,
  getPostDescription,
  getPostPath,
  getPostPathParams,
  getPostTags,
  getPostUpdatedDate,
  getReadingMinutes,
  getRelatedPosts,
  getShanghaiPeriod,
  site,
  sortPosts,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts'));

  // 规范 URL 是 getPostPath() 产出的 /posts/{分类标识}/{id} —— sitemap、RSS、canonical、
  // CMS 侧渲染全部按这个形态引用；这里额外保留历史 /posts/{id}/ 入口并 301 过去，
  // 否则旧链接（以及已被搜索引擎收录的地址）会全部 404。
  // 注：改用「分类标识」之前的历史链接 /posts/{中文分类名}/{id} 由 CMS catch-all 做 301。
  return [
    ...posts.map((post) => ({
      params: { slug: getPostPathParams(post) },
      // 两个分支的 props 形状保持一致（canonicalPath 显式带 undefined）：
      // 否则 getStaticPaths 的联合类型会让解构出的 canonicalPath 报「属性不存在」
      props: { post, canonicalPath: undefined },
    })),
    ...posts.map((post) => ({
      params: { slug: String(post.id) },
      // 静态产物里旧地址仍然是一份完整页面（redirect 只在有 adapter 时生效），
      // 所以同时把 canonical 指向新形态；真 301 由 CMS 的 catch-all 路由负责。
      props: { post, canonicalPath: getPostPath(post) },
      redirect: { to: getPostPath(post), status: 301 as const },
    })),
  ];
}

const { post, canonicalPath } = Astro.props;
// 旧 URL 形态（/posts/{id}/）会生成一份完整静态副本：canonical 指向新形态，
// 同时 noindex 提示搜索引擎不要收录重复页，真 301 由 CMS catch-all 负责。
const isLegacyDuplicate = Boolean(canonicalPath);
const posts = sortPosts(await getCollection('posts'));
const { Content, headings } = await render(post);
const category = getPostCategory(post);
const tags = getPostTags(post);
const description = getPostDescription(post);
const cover = getPostCover(post);
const readingMinutes = getReadingMinutes(post);
const { newer, older } = getAdjacentPosts(posts, post);
const relatedPosts = getRelatedPosts(posts, post);

// 相邻文章横幅（排在版权条上方）：卡片用对方的封面做大图底、加模糊，文字是「标题【分类】」。
// 封面必须由 <img> 承载：同步净化器会整条丢掉内联 style 里的 url()，
// 所以 background-image 写不进 style 里，只能走元素本身。
const adjacentCards = [
  { direction: 'prev' as const, label: '上一篇', emptyLabel: '已经是最早一篇了', post: older },
  { direction: 'next' as const, label: '下一篇', emptyLabel: '已经是最新一篇了', post: newer },
].map((card) => ({
  ...card,
  cover: card.post ? getPostCover(card.post) : undefined,
  category: card.post ? getPostCategory(card.post) : undefined,
}));
const tableOfContents = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);

// 版权条：只用后台站点设置里的作者名（与页脚同口径），不引入新字段。
// 「本文由 X 于 <日期> <时段> 发布」里的日期与时段都走 shared/post-utils 的固定
// Asia/Shanghai 实现，保证与构建机时区无关。
// 这段 markup 在后台同步时由 blog-render.tsx 的 renderArticleLicense() 用同一套
// 文案重算（同步会整块替换 articleFooter），两处任何一处改动都要同步另一处。
const siteSettings = await getSiteSettings();
const licenseOwner = siteSettings?.siteAuthor ?? site.author;
const licenseSiteName = siteSettings?.siteName ?? site.name;
const licenseUrl = absoluteUrl(getPostPath(post));
const licenseDate = formatDate(post.data.date);
const licensePeriod = getShanghaiPeriod(post.data.date);
// 日期和时段拼好后一起放进 <time>：Astro 会把模板里的换行折叠成一个空格，
// 拼成变量能保证前后台同步出来的 HTML 一模一样（blog-render.tsx 里同样拼法）。
const licenseCardDate = licensePeriod ? `${licenseDate} ${licensePeriod}` : licenseDate;

// Group h3s under their parent h2 so the sidebar can reveal a section's
// children only while reading that section (same pattern as the notes index).
type TocGroup = { slug: string; text: string; children: { slug: string; text: string }[] };
const tocGroups: TocGroup[] = [];
for (const heading of tableOfContents) {
  if (heading.depth === 2 || tocGroups.length === 0) {
    tocGroups.push({ slug: heading.slug, text: heading.text, children: [] });
  } else {
    tocGroups[tocGroups.length - 1].children.push({ slug: heading.slug, text: heading.text });
  }
}

const updatedDate = getPostUpdatedDate(post);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description,
  inLanguage: 'zh-CN',
  url: absoluteUrl(getPostPath(post)),
  mainEntityOfPage: absoluteUrl(getPostPath(post)),
  ...(post.data.date ? { datePublished: post.data.date.toISOString() } : {}),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: post.data.author ?? site.author, url: site.url },
  publisher: { '@type': 'Person', name: site.author, url: site.url },
  ...(cover ? { image: cover } : {}),
  ...(tags.length > 0 ? { keywords: tags.join(', ') } : {}),
};
---

<BaseLayout
  title={post.data.title}
  description={description}
  pageClass="article-page"
  image={cover}
  type="article"
  jsonLd={articleSchema}
  canonicalPath={canonicalPath}
  noindex={isLegacyDuplicate}
  articleMeta={{
    ...(post.data.date ? { publishedTime: post.data.date.toISOString() } : {}),
    ...(updatedDate ? { modifiedTime: updatedDate.toISOString() } : {}),
    ...(category ? { section: category } : {}),
    ...(tags.length > 0 ? { tags } : {}),
  }}
>
  <article class:list={['article', tableOfContents.length >= 2 && 'article--toc']}>
    <a class="back-link" href="/">
      <Icon name="arrow-right" size={16} class="back-link__arrow" />
      返回首页
    </a>

    <header class="article__header" data-sync-block="articleHeader">
      <div class="post-meta">
        {category && <span>{category}</span>}
        {post.data.date && (
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        )}
        {post.data.updated && (
          <span>更新于 {formatDate(post.data.updated)}</span>
        )}
        <span>{readingMinutes} 分钟阅读</span>
      </div>
      <h1>{post.data.title}</h1>
      <p>{description}</p>
      {tags.length > 0 && (
        <div class="tag-list" aria-label="标签">
          {tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </header>

    <div class="article__body">
      <div class="article__main">
        <div class="post-content" data-sync-block="postContent">
          <Content />
        </div>

        <footer class="article__footer" data-sync-block="articleFooter">
          {/* 相邻文章：封面大图横幅卡，排在版权条上方。
              两栏永远成对渲染 —— 缺上一篇/下一篇时用不可点击的虚线占位卡补位，
              否则剩一张卡会撑满整行、位置还会左右跳动。
              结构与 blog-render.tsx 的 renderArticleFooter() 逐字对应。 */}
          {(older || newer) && (
            <nav class="post-nav" aria-label="相邻文章">
              {adjacentCards.map((card) =>
                card.post ? (
                  <a
                    class={`post-nav__card post-nav__card--${card.direction}`}
                    href={getPostPath(card.post)}
                  >
                    {card.cover ? (
                      <img
                        class="post-nav__cover"
                        src={card.cover}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        referrerpolicy="no-referrer"
                      />
                    ) : (
                      <span class="post-nav__cover post-nav__cover--fallback" aria-hidden="true" />
                    )}
                    <span class="post-nav__mask" aria-hidden="true" />
                    <span class="post-nav__text">
                      <span class="post-nav__label">{card.label}</span>
                      <span class="post-nav__title">
                        {card.post.data.title}
                        {card.category && <span class="post-nav__category">【{card.category}】</span>}
                      </span>
                    </span>
                  </a>
                ) : (
                  <span
                    class={`post-nav__card post-nav__card--${card.direction} post-nav__card--empty`}
                  >
                    <span class="post-nav__text">
                      <span class="post-nav__label">{card.label}</span>
                      <span class="post-nav__title">{card.emptyLabel}</span>
                    </span>
                  </span>
                ),
              )}
            </nav>
          )}

          {/* 版权条：只声明原创文章的转载规则，不涉及评论等用户内容。
              条款正文在站内 /privacy 的「文章版权」一节，这里只做三行提示，不再重复链接过去。
              结构与 blog-render.tsx 的 renderArticleLicense() 逐字对应。 */}
          <section class="post-license" aria-label="文章版权">
            <span class="post-license__watermark" aria-hidden="true">CC</span>
            <p class="post-license__line">本文由 <span class="post-license__author">{licenseOwner}</span>{licenseDate ? <Fragment> 于 <time datetime={post.data.date?.toISOString()}>{licenseCardDate}</time> 发布</Fragment> : <Fragment> 发布</Fragment>}</p>
            <p class="post-license__line">文章地址：<a class="post-license__title-link" href={licenseUrl}>{post.data.title}</a></p>
            <p class="post-license__line">本站原创文章除特别声明外，均采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh-hans" target="_blank" rel="noopener noreferrer">CC BY-NC-SA 4.0</a> 许可协议。完整转载请注明来自 <a href="/">{licenseSiteName}</a>！</p>
          </section>

          {relatedPosts.length > 0 && (
            <section class="related-posts" aria-labelledby="related-heading">
              <h2 id="related-heading">相关文章</h2>
              <div class="related-posts__grid">
                {relatedPosts.map((relatedPost) => (
                  <a href={getPostPath(relatedPost)}>
                    <span>{getPostCategory(relatedPost) ?? '文章'}</span>
                    <strong>{relatedPost.data.title}</strong>
                    <small>{getPostDescription(relatedPost)}</small>
                  </a>
                ))}
              </div>
            </section>
          )}
        </footer>
      </div>

      {tableOfContents.length >= 2 && (
        <aside class="article__aside" data-sync-block="tocSidebar">
          <nav class="toc" aria-labelledby="toc-heading">
            <h2 id="toc-heading">目录</h2>
            <ol>
              {tocGroups.map((group) => (
                <li class="toc__group toc__item--depth-2">
                  <a href={`#${group.slug}`}>{group.text}</a>
                  {group.children.length > 0 && (
                    <div class="toc__sub">
                      <ol class="toc__children">
                        {group.children.map((child) => (
                          <li class="toc__item--depth-3">
                            <a href={`#${child.slug}`}>{child.text}</a>
                          </li>
                        ))}
                      </ol>
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </div>

    <CommentsBox />
  </article>
</BaseLayout>
