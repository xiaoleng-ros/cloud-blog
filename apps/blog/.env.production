# 前台（Astro）生产环境变量 —— 在 EdgeOne 构建时被加载
# 说明：
#  - 本文件只含公开链接/站名等不敏感配置，不包含任何密钥，因此允许提交到仓库，
#    保证云端构建有默认值可用。
#  - 站点域名（SITE_URL / PUBLIC_PAYLOAD_URL）部署后会由 CDN 分配真实域名，
#    上线后可改成你真实的 EdgeOne 域名；当前用占位符与代码默认值保持一致。

# 站点根地址（用于 canonical、RSS、OG 链接等；部署后替换为真实域名）
SITE_URL=https://example.com

# Payload 后台 API 地址：前台（Astro）在构建时从后台拉取文章/随笔/站点设置。
# 部署后一般与前台同域，即 /api，用后台服务地址即可。
PUBLIC_PAYLOAD_URL=https://your-domain.example.com

# Twikoo 评论服务环境 ID（留空 = 关闭评论）
PUBLIC_TWIKOO_ENV_ID=

# 网易云音乐歌单（前台音乐播放器）
PUBLIC_NETEASE_PLAYLIST_ID=8792942606
PUBLIC_MUSIC_API=https://meting.mikus.ink/api