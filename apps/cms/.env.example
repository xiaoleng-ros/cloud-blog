# Payload 后台（apps/cms）环境变量示例
# 复制为 .env 后按需填写。

# 数据库驱动：本地开发默认 sqlite（单文件，零配置）；生产用 postgres
# DATABASE_DRIVER=postgres
# POSTGRES_URL=postgres://user:pass@host:5432/dbname

# Payload 加密密钥（生产必填，生成一串长随机字符串，建议 >= 48 字符）
# PAYLOAD_SECRET=please-change-me-to-a-long-random-string
#
# 强校验开关：设为 1 时，若 PAYLOAD_SECRET 缺失/过短/含占位关键词则直接抛错。
# 生产环境强烈建议开启；本地开发可留空以保留兜底行为。
# PAYLOAD_REQUIRE_SECRET=1

# Postgres SSL 严格模式：设为 1 时使用 sslmode=prefer + rejectUnauthorized=true，
# 避免中间人攻击。默认关闭以兼容 EdgeOne 出口网络的 TLS 拦截。
# 上游数据库提供有效 CA 链后可开启。
# PG_SSL_STRICT=1

# 首次向线上数据库非交互建表时设为 1（迁移后移除）
# PAYLOAD_FORCE_PUSH=1

# ─── 图片对象存储（可选，配齐后启用；未配走本地磁盘） ───
# 配齐后，Media 上传的图片会存到 Supabase Storage，而不是容器本地磁盘
# 生产环境（EdgeOne）必须配置以下三项：

# 1. Supabase Service Role Key
#    路径：Supabase Dashboard → Project Settings → API → service_role key
#    ⚠️ 用 service_role 不是 anon key：service_role 绕过 RLS 策略，才能直接读写 Storage
#    ⚠️ 不要泄露到前端；仅放在服务端环境变量
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0....

# 2. Supabase Storage 桶名
#    路径：Supabase Dashboard → Storage → Create bucket → 命名（建议 "blog-media"）
#    勾选 "Public" 让图片可以通过公开 URL 直接访问（博客场景够用）
# SUPABASE_BUCKET=blog-media

# 3.（可选）Supabase Storage endpoint
#    默认从 POSTGRES_URL 里的 project ref 自动拼接
#    例：POSTGRES_URL 里的 ref 是 abc123，则 endpoint 默认为
#        https://abc123.supabase.co/storage/v1
#    如需手动指定（例如自建代理、内网地址），才需设置此项：
# SUPABASE_STORAGE_ENDPOINT=https://abc123.supabase.co/storage/v1
