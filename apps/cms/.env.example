# Payload 后台（apps/cms）环境变量示例
# 复制为 .env 后按需填写。

# 数据库驱动：生产用 postgres；本地开发也已默认 postgres，但指向 D:\pglocal 的绿色版 PG
# （见下方 POSTGRES_URL）。SQLite 分支仍保留，但因 migrations/ 是 Postgres 方言，
# 用它就无法复用线上迁移，不推荐。
# DATABASE_DRIVER=postgres
# POSTGRES_URL=postgres://user:pass@host:5432/dbname
#
# 本地绿色版 PG（按需启动、零常驻，不注册 Windows 服务）：
#   npm run pg:start / pg:stop / pg:status
#   POSTGRES_URL=postgresql://postgres@127.0.0.1:5433/blog_dev
# 本机连接会自动跳过 SSL（pg 只要拿到 ssl 配置对象就会强制 TLS，会报
# "The server does not support SSL connections"）；如需给本地 PG 开 SSL：PG_LOCAL_SSL=1。
#
# 连线上库（生成/核对迁移时才需要，日常开发别连）：
#   cp .env.supabase 里的两行到 .env，或 npm run dev:supabase
# Supabase 有两个端口，选错会很慢：5432 是会话池（直连，ORM 用它），
# 6543 是事务池（PgBouncer，为无状态函数设计）——Payload/drizzle 的长连接与
# prepared statement 在事务池上会被反复丢弃，请填 5432。
#
# 连接池上限：默认生产 10、dev 3。
# 需要本地并发压测时覆盖：PG_POOL_MAX=10

# SQLite 分支（DATABASE_DRIVER=sqlite）的库文件路径；默认 file:./payload.db
# DATABASE_URL=file:./payload.db

# 给本地绿色版 PG 强制开启 SSL（走远程严格校验分支）；默认本机连接跳过 TLS
# PG_LOCAL_SSL=1

# Payload 加密密钥（**生产必填**，生成一串长随机字符串，建议 >= 48 字符）
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ NODE_ENV=production 时缺失/过短/含占位关键词会直接退出（不再静默回落）。
#    若线上目前依赖内置兜底密钥，请先在部署平台配好本变量再发布，否则会启动失败。
# PAYLOAD_SECRET=
#
# 强校验开关：设为 1 时，本地开发也走生产级硬校验（用于 CI 演练 / 上线前自检）。
# PAYLOAD_REQUIRE_SECRET=1

# Postgres SSL：默认严格（sslmode=prefer + rejectUnauthorized=true）。
# 仅当上游确实没有有效 CA 链、连通失败时，才显式降级：
# PG_SSL_INSECURE=1   # 等价于旧的 sslmode=no-verify + 不校验证书，存在中间人风险，解决 CA 后请移除

# 首次向线上数据库非交互建表时设为 1（迁移后移除）
# PAYLOAD_FORCE_PUSH=1

# ─── 图片对象存储（可选，配齐后启用；未配走本地磁盘） ───
# 配齐后，Media 上传的图片会存到 Supabase Storage（S3 协议），落库的 url 即公开地址，
# 浏览器直连 Storage；未配则落项目本地 apps/cms/media/。

# 1. S3 协议密钥对（两项都必须）
#    路径：Supabase Dashboard → Project Settings → Storage → S3 Access Keys
#         （或 Storage 页「Connect to S3」里 Create new access key）
#    ⚠️ 不是 API 页的 service_role JWT —— S3 协议只认这里生成的 Access Key ID / Secret。
#    ⚠️ 仅服务端环境变量，绝不进前端或提交仓库。
# SUPABASE_S3_ACCESS_KEY_ID=<生成的 Access Key ID>
# SUPABASE_S3_SECRET_ACCESS_KEY=<生成的 Secret Access Key>

# 2. Supabase Storage 桶名（须为公开读桶；私有桶图片会 403）
#    路径：Supabase Dashboard → Storage → Create bucket → 命名（本项目用 "blog-media"）
# SUPABASE_BUCKET=blog-media

# 3.（可选）项目 ref
#    缺省时从 POSTGRES_URL 主机名里的 ref 推导（aws-0-xx.<ref>.pooler.supabase.com → <ref>）。
#    本地库指向 127.0.0.1 时推不出来，此时必须显式配本项或直接配下面 4/5 两项。
# SUPABASE_PROJECT_REF=abc123

# 4./5.（可选）端点覆盖。默认值为：
#    SUPABASE_S3_ENDPOINT   = https://<ref>.supabase.co/storage/v1/s3      （S3 API，缺 /s3 会 404）
#    SUPABASE_PUBLIC_BASE   = https://<ref>.supabase.co/storage/v1/object/public （公开读前缀）
#    两个端点必须分开配：插件自带的 URL 拼接是 endpoint/bucket/key，而 Supabase 的
#    S3 路径不接受匿名 GET，所以图片地址由 payload.config.ts 的 generateFileURL 单独生成。
# SUPABASE_S3_ENDPOINT=https://abc123.supabase.co/storage/v1/s3
# SUPABASE_PUBLIC_BASE=https://abc123.supabase.co/storage/v1/object/public

# ─── 飞书扫码登录（可选，作为「忘记密码」的兜底通道） ───
# 用途：登录页会显示「用飞书扫码登录」按钮；忘记密码时可扫码登入 → 进账号页改密码
# 前置：已在 https://open.feishu.cn 创建企业自建应用，并把本仓库的 callback URL 加进「安全设置 → 重定向 URL」
#
# 1. 飞书应用 App ID
#    路径：飞书开发者后台 → 我的应用 → 应用凭证 → App ID
# FEISHU_APP_ID=cli_xxxxxxxxxx
#
# 2. 飞书应用 App Secret（保密，仅服务端使用）
#    路径：飞书开发者后台 → 我的应用 → 应用凭证 → App Secret
# FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxx
#
# 3. 回调地址（必须与飞书「重定向 URL」列表里的一致，且必须以 HTTPS 开头）
#    例：生产 https://blog.example.com/api/feishu/callback
#    本地开发可用 http://localhost:9527/api/feishu/callback（需在飞书白名单里加 localhost）
# FEISHU_REDIRECT_URI=https://blog.example.com/api/feishu/callback
#
# 4. 管理员邮箱白名单（逗号分隔）
#    决定「谁能查看/管理其他账号」（Users 集合的 read/update/delete）。
#    未配置时每个账号只能读写自己的资料 —— 单人后台通常只填自己那一个邮箱。
# CMS_ADMIN_EMAILS=you@example.com
#
# 5.（可选）匿名草稿预览开关
#    设为 1 时，未登录也能从 REST/GraphQL 读到 status=draft 的文章/随笔/项目。
#    仅用于本地排查前台渲染问题，生产环境务必保持关闭（默认关闭）。
# CMS_DRAFT_PREVIEW=1
#
# 6.（可选）本地 http 开发时关闭 cookie 的 Secure 标记
#    生产走 https 不需要设置；设为 1 仅用于 http://localhost 调试飞书回调。
# FEISHU_INSECURE_COOKIES=1

# ─── 站点与静态博客输出（前台渲染 / 兜底静态服务） ───

# 站点公开访问的基址（用于 OG / sitemap / 前台绝对链接等）。未设置时 blog-render 回落 https://example.com
# NEXT_PUBLIC_SERVER_URL=https://blog.example.com

# 博客 HTML 外壳目录（public/__blog）的绝对/相对路径覆盖。正常留空由路由自动探测，
# 仅在 EdgeOne 容器工作目录漂移、探测不到时用它应急（改控制台即可，无需重新部署）
# CMS_HTML_DIR=

# 静态资源根目录（public，CSS/JS/图片兜底服务）的路径覆盖，用途同上
# CMS_PUBLIC_DIR=

# ─── Waline 评论服务（进程内挂载在 /api/waline）───
# 完整配方（建表、首次注册管理员、审核命令）见 scripts/waline/README.md。
# 关键：Waline 只读下面这组拆分变量，与 Payload 的 POSTGRES_URL 互不影响。
# 本地把 wl_* 建在独立的 waline schema（Payload dev force-push 只 introspect public，不会误删）；
# 生产 Payload 从不 push，直接建在 public 即可。
# POSTGRES_DATABASE=blog_dev
# POSTGRES_USER=waline_user
# POSTGRES_PASSWORD=xxxxxxxx
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
# POSTGRES_PREFIX=wl_
# POSTGRES_SSL=true              # Supabase 直连必需，本地留空
# JWT_TOKEN=                     # 管理端登录令牌签名密钥，openssl rand -hex 32
# COMMENT_AUDIT=true             # 先审后发：新评论落 waiting，批准后才公开
# IPQPS=60                       # 同一 IP 两次提交最小间隔（秒）
# FORBIDDEN_WORDS=词1,词2         # 逗号分隔敏感词，命中即标 spam
