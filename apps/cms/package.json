{
  "name": "payload-blog",
  "version": "1.0.0",
  "description": "基于 Payload CMS 3 + Next.js 的博客内容后台（Postgres，前后台一体化部署）",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 9527",
    "pg:start": "node scripts/pg.mjs start",
    "pg:stop": "node scripts/pg.mjs stop",
    "pg:status": "node scripts/pg.mjs status",
    "dev:local": "node scripts/pg.mjs start && npm run dev",
    "dev:warm": "node scripts/dev-warm.mjs",
    "dev:supabase": "node scripts/with-env.mjs .env.supabase npm run dev",
    "payload:supabase": "node scripts/with-env.mjs .env.supabase npx payload",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "import:data": "cross-env NODE_OPTIONS=--no-deprecation npx tsx src/scripts/import-markdown.ts",
    "generate:preview-css": "node scripts/generate-preview-css.mjs",
    "warmup": "node scripts/warmup.mjs",
    "verify:html-inject": "node scripts/verify-html-inject.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "typecheck": "cross-env NODE_OPTIONS=--no-deprecation tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@waline/vercel": "^1.43.4",
    "cloud-blog": "file:../..",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "jose": "^5.10.0",
    "next": "16.3.8",
    "parse5": "^7.3.0",
    "payload": "3.88.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.34.5",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "vditor": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "gray-matter": "^4.0.3",
    "patch-package": "8.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
