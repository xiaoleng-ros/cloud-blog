{
  "name": "cloud-blog",
  "private": true,
  "version": "1.0.0",
  "description": "云岫的博客 Monorepo：apps/blog（Astro 前端）+ apps/cms（Payload CMS 后台），两个独立应用可分别部署到 EdgeOne Makers。",
  "license": "GPL-3.0-only",
  "exports": {
    ".": "./package.json",
    "./shared/*": "./shared/*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "setup": "npm install --prefix apps/blog && npm install --prefix apps/cms",
    "dev:blog": "npm run dev --prefix apps/blog",
    "dev:cms": "npm run dev --prefix apps/cms",
    "dev:proxy": "npm run dev:proxy --prefix apps/blog",
    "build:all": "npm run build --prefix apps/blog && npm run build --prefix apps/cms && node apps/cms/scripts/copy-blog-to-public.mjs && node apps/cms/scripts/prerender-blog-shells.mjs && npm run verify:html-inject && npm run verify:csp && npm run verify:render",
    "sync:blog": "node apps/cms/scripts/sync-blog-shells.mjs",
    "prerender:blog": "node apps/cms/scripts/prerender-blog-shells.mjs",
    "verify:html-inject": "node apps/cms/scripts/verify-html-inject.mjs",
    "verify:csp": "node apps/cms/scripts/verify-csp-sync.mjs",
    "verify:render": "node apps/cms/scripts/verify-render-parity.mjs",
    "fmt": "node scripts/run-prettier.mjs --write",
    "fmt:check": "node scripts/run-prettier.mjs --check",
    "fmt:changed": "node scripts/run-prettier.mjs --check --changed",
    "typecheck": "npm run typecheck:blog && npm run typecheck:cms",
    "typecheck:blog": "npm run typecheck --prefix apps/blog",
    "typecheck:cms": "npm run typecheck --prefix apps/cms",
    "dev:cms:warm": "npm run dev:warm --prefix apps/cms",
    "build:blog": "npm run build --prefix apps/blog",
    "build:cms": "npm run build --prefix apps/cms",
    "preview:blog": "npm run preview --prefix apps/blog"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
