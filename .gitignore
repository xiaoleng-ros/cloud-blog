node_modules/
dist/
.astro/
.next/

# CMS 后台（apps/cms）独立依赖、构建产物、本地数据库
apps/cms/payload.db*
apps/cms/dev.log
apps/cms/.next/
apps/cms/dist/
apps/cms/node_modules/
apps/cms/tsconfig.tsbuildinfo

# 前端（apps/blog）独立依赖与构建产物
apps/blog/node_modules/
apps/blog/dist/
apps/blog/.astro/

# CMS public 中由 Astro 构建生成的博客静态文件（每次构建重新复制，不提交）
apps/cms/public/*
!apps/cms/public/cloud-icons/
!apps/cms/public/cloud-icons/**

# Local environment
.env
.env.*
!.env.example
# 前台（apps/blog）的 .env.production 只含公开链接，允许提交供云端构建保底
!apps/blog/.env.production

# Local tool/editor state
.claude/
.vscode/
.idea/
.workbuddy/

# Logs and OS caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store

# Temporary debug files
.d.txt

# 方案/设计稿类文档（个人工作笔记，禁止入库）
# 命名匹配即视为草稿，正式规范请落到代码内注释或 README 对应章节
**/*-style-guide.md
**/*-design.md
**/*-plan.md
**/*-spec.md
**/*-draft.md
**/*方案*.md
**/*改造*.md
**/*规范*.md
