# 编辑器基线风格 —— 与 .prettierrc.json 保持一致，让「不装 Prettier 的编辑器」也能自动对齐。
#
# 为什么单独存在：Prettier 只在 `npm run fmt` 时生效，而 .editorconfig 是编辑器原生
# 支持的（VS Code / WebStorm / Vim / Sublime 都内置或有一等插件），保存即对齐。
#
# 注意这里**故意不设 end_of_line**：仓库内文本以 LF 入库，工作区因 git 的
# core.autocrlf=true 是 CRLF。写死 crlf 会让 Linux/CI 检出（LF）与规则冲突，
# 写死 lf 又会在 Windows 上把整个工作区改写掉。换行统一交给 git 处理，
# Prettier 侧对应 endOfLine: "auto"。

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 里行尾两个空格是「硬换行」，不能被编辑器自动删掉
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
