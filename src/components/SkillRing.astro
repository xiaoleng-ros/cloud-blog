---
export interface Props {
  label: string;
  sublabel?: string;
  value: number;
  color?: 'yellow' | 'cyan' | 'pink' | 'purple';
}

const { label, sublabel, value, color = 'yellow' } = Astro.props;

const colorMap = {
  yellow: 'var(--sticky-yellow)',
  cyan: 'var(--sticky-cyan)',
  pink: 'var(--sticky-pink)',
  purple: 'var(--sticky-purple)',
};

const ringColor = colorMap[color];
const percent = Math.min(100, Math.max(0, value));
---

<div class="skill-ring">
  <div class="skill-ring__track" aria-hidden="true">
    <div
      class="skill-ring__fill"
      style={`--ring-color: ${ringColor}; --percent: ${percent}%`}
    ></div>
    <span class="skill-ring__value">{percent}%</span>
  </div>
  <div class="skill-ring__text">
    <strong>{label}</strong>
    {sublabel && <small>{sublabel}</small>}
  </div>
</div>
